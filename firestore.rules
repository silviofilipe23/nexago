rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    // Multi-role: claim `roles` (lista) é a única fonte de papéis
    function hasRoleClaim(r) {
      return request.auth != null &&
        request.auth.token.roles is list && r in request.auth.token.roles;
    }

    function isAdmin() {
      return request.auth != null && hasRoleClaim('admin');
    }
    function isSuperAdmin() {
      return request.auth != null &&
        ('superAdmin' in request.auth.token) &&
        request.auth.token.superAdmin == true;
    }
    function isArena() {
      return request.auth != null && hasRoleClaim('arena');
    }
    /** Gestor de torneios (backoffice operacional); não confundir com admin da plataforma. */
    function isTournamentOrganizer() {
      return request.auth != null && hasRoleClaim('organizer');
    }
    function isValidTournamentListingStatus(status) {
      return status is string && status in ['draft', 'open'];
    }
    function isValidLeagueListingStatus(status) {
      return status is string && status in ['draft', 'open', 'closed', 'cancelled'];
    }
    function leagueListingStatusTransitionAllowed(before, after) {
      return before == after ||
        (before == 'draft' && after in ['open', 'cancelled']) ||
        (before == 'open' && after in ['closed', 'cancelled']);
    }
    function organizerCanUpdateOwnLeague() {
      return request.auth != null &&
        resource.data.managerId == request.auth.uid &&
        request.resource.data.managerId == resource.data.managerId &&
        isValidLeagueListingStatus(request.resource.data.listingStatus) &&
        leagueListingStatusTransitionAllowed(
          resource.data.listingStatus,
          request.resource.data.listingStatus
        );
    }
    function organizerCanCreateTournament() {
      return request.auth != null &&
        isTournamentOrganizer() &&
        request.resource.data.managerId == request.auth.uid &&
        request.resource.data.name is string &&
        request.resource.data.name.size() >= 3 &&
        request.resource.data.city is string &&
        request.resource.data.locationName is string &&
        request.resource.data.startAt is timestamp &&
        request.resource.data.endAt is timestamp &&
        request.resource.data.listingStatus is string &&
        isValidTournamentListingStatus(request.resource.data.listingStatus) &&
        request.resource.data.enrolledCount == 0 &&
        (!('collectedCents' in request.resource.data) ||
         request.resource.data.collectedCents == 0) &&
        request.resource.data.categories is list &&
        request.resource.data.categories.size() >= 1;
    }
    function organizerCanUpdateOwnTournament() {
      return request.auth != null &&
        resource.data.managerId == request.auth.uid &&
        request.resource.data.managerId == resource.data.managerId &&
        request.resource.data.enrolledCount == resource.data.enrolledCount &&
        request.resource.data.collectedCents == resource.data.collectedCents &&
        request.resource.data.listingStatus is string &&
        isValidTournamentListingStatus(request.resource.data.listingStatus);
    }
    function isTournamentOwner(tournamentId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/tournaments/$(tournamentId)) &&
        get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.managerId == request.auth.uid;
    }
    function isTournamentStaff(tournamentId, allowedRoles) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/tournaments/$(tournamentId)/staff/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/tournaments/$(tournamentId)/staff/$(request.auth.uid)).data.status == 'active' &&
        allowedRoles.hasAny([
          get(/databases/$(database)/documents/tournaments/$(tournamentId)/staff/$(request.auth.uid)).data.role
        ]);
    }
    function canManageTournament(tournamentId) {
      return request.auth != null && (
        isAdmin() ||
        isSuperAdmin() ||
        isTournamentOwner(tournamentId) ||
        isTournamentStaff(tournamentId, ['manager'])
      );
    }
    function canScoreTournament(tournamentId) {
      return request.auth != null && (
        isAdmin() ||
        isSuperAdmin() ||
        isTournamentOwner(tournamentId) ||
        isTournamentStaff(tournamentId, ['manager', 'scorer'])
      );
    }
    function scorerCanOnlyEditScoreFields() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
        'resultA',
        'resultB',
        'winnerId',
        'status',
        'sets',
        'currentSetIndex',
        'matchStartedAt',
        'matchEndedAt',
        'lastActions',
        'pointEventSeq',
        'updatedAt'
      ]);
    }
    function inscriptionParticipantUidsMatchTeam(appId, teamId) {
      return !('participantUids' in request.resource.data) ||
        (
          request.resource.data.participantUids is list &&
          request.resource.data.participantUids.size() == 2 &&
          exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/teams/$(teamId)) &&
          (
            (
              request.resource.data.participantUids[0] == get(/databases/$(database)/documents/artifacts/$(appId)/public/data/teams/$(teamId)).data.player1Id &&
              request.resource.data.participantUids[1] == get(/databases/$(database)/documents/artifacts/$(appId)/public/data/teams/$(teamId)).data.player2Id
            ) ||
            (
              request.resource.data.participantUids[0] == get(/databases/$(database)/documents/artifacts/$(appId)/public/data/teams/$(teamId)).data.player2Id &&
              request.resource.data.participantUids[1] == get(/databases/$(database)/documents/artifacts/$(appId)/public/data/teams/$(teamId)).data.player1Id
            )
          )
        );
    }
    function inscriptionParticipantUidsImmutable() {
      return !('participantUids' in request.resource.data) ||
        request.resource.data.participantUids == resource.data.participantUids;
    }
    function inscriptionCoreFieldsImmutable() {
      return request.resource.data.tournamentId == resource.data.tournamentId &&
        request.resource.data.categoryId == resource.data.categoryId &&
        request.resource.data.teamId == resource.data.teamId;
    }
    function inscriptionPaymentFieldsUnchanged() {
      return (!('isPaid' in request.resource.data) ||
              request.resource.data.isPaid == resource.data.isPaid) &&
        (!('paidAmount' in request.resource.data) ||
         request.resource.data.paidAmount == resource.data.paidAmount) &&
        (!('sharePaidUids' in request.resource.data) ||
         request.resource.data.sharePaidUids == resource.data.sharePaidUids) &&
        (!('paidAt' in request.resource.data) ||
         request.resource.data.paidAt == resource.data.paidAt);
    }
    function inscriptionEnrollmentFieldsUnchanged() {
      return (!('waitlist' in request.resource.data) ||
              request.resource.data.waitlist == resource.data.waitlist);
    }
    function inscriptionCreatePaymentSafe() {
      return (!('isPaid' in request.resource.data) ||
              request.resource.data.isPaid == false) &&
        (!('paidAmount' in request.resource.data) ||
         request.resource.data.paidAmount == 0) &&
        (!('sharePaidUids' in request.resource.data) ||
         request.resource.data.sharePaidUids.size() == 0) &&
        !('paidAt' in request.resource.data);
    }
    function teamPlayerIdsUnchanged() {
      return request.resource.data.player1Id == resource.data.player1Id &&
        request.resource.data.player2Id == resource.data.player2Id;
    }
    function managerCanOnlyEditMatchFields() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
        'courtId',
        'courtName',
        'scheduleTime',
        'scheduleEndTime',
        'dayKey',
        'queueOrder',
        'queueStatus',
        'checkIn',
        'servingTeamId',
        'report',
        'liveElapsedSec',
        'resultA',
        'resultB',
        'winnerId',
        'status',
        'sets',
        'currentSetIndex',
        'matchStartedAt',
        'matchEndedAt',
        'lastActions',
        'pointEventSeq',
        'updatedAt'
      ]) &&
        request.resource.data.teamAId == resource.data.teamAId &&
        request.resource.data.teamBId == resource.data.teamBId &&
        request.resource.data.tournamentId == resource.data.tournamentId &&
        request.resource.data.categoryId == resource.data.categoryId;
    }
    function matchDoc(appId, matchId) {
      return get(/databases/$(database)/documents/artifacts/$(appId)/public/data/matches/$(matchId));
    }
    function canWriteMatchPointEvents(appId, matchId) {
      return request.auth != null && matchDoc(appId, matchId).data != null && (
        isAdmin() ||
        isSuperAdmin() ||
        canManageTournament(matchDoc(appId, matchId).data.tournamentId) ||
        canScoreTournament(matchDoc(appId, matchId).data.tournamentId)
      );
    }
    function isValidPointEventCreate(appId, matchId) {
      let expectedSeq = matchDoc(appId, matchId).data.get('pointEventSeq', 0) + 1;
      return request.resource.data.keys().hasAll(['seq', 'type', 'setIndex', 'scoreA', 'scoreB', 'ts']) &&
        request.resource.data.seq is int &&
        request.resource.data.seq == expectedSeq &&
        request.resource.data.type in ['match-start', 'point', 'set-end', 'undo-point', 'undo-set-end', 'match-end'] &&
        request.resource.data.setIndex is int &&
        request.resource.data.setIndex >= 0 &&
        request.resource.data.setIndex <= 2 &&
        request.resource.data.scoreA is int &&
        request.resource.data.scoreB is int &&
        request.resource.data.scoreA >= 0 &&
        request.resource.data.scoreB >= 0 &&
        request.resource.data.ts is timestamp;
    }
    function organizerCanCreateOperationalTorneio() {
      return request.auth != null &&
        isTournamentOrganizer() &&
        request.resource.data.managerId == request.auth.uid;
    }
    function organizerCanUpdateOwnOperationalTorneio() {
      return request.auth != null &&
        isTournamentOrganizer() &&
        resource.data.managerId == request.auth.uid &&
        request.resource.data.managerId == resource.data.managerId;
    }
    function organizerCanDeleteOwnOperationalTorneio() {
      return request.auth != null &&
        isTournamentOrganizer() &&
        resource.data.managerId == request.auth.uid;
    }

    function userDocIsPublicAthlete(resource) {
      return resource != null && (
        resource.data.hasAthleteRole == true ||
        (resource.data.roles is list && 'athlete' in resource.data.roles)
      );
    }
    /** Atleta logado pré-cadastra parceiro sem conta (inscrição em torneio). */
    function authUserHasAthleteProfile() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles is list &&
        'athlete' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles;
    }
    function inviterCanPreRegisterPartner() {
      return request.auth != null && (
        hasRoleClaim('athlete') ||
        authUserHasAthleteProfile()
      );
    }
    function isPartnerPreRegistrationCreate(targetUserId) {
      return request.auth != null &&
        request.auth.uid != targetUserId &&
        inviterCanPreRegisterPartner() &&
        !('role' in request.resource.data) &&
        request.resource.data.roles is list &&
        request.resource.data.roles.hasOnly(['athlete']) &&
        request.resource.data.roles.size() > 0 &&
        request.resource.data.partnerInviteStatus == 'pending' &&
        request.resource.data.invitedByUid == request.auth.uid &&
        request.resource.data.fullName is string &&
        request.resource.data.fullName.size() > 0 &&
        request.resource.data.email is string &&
        request.resource.data.email.size() > 0 &&
        (!('superAdmin' in request.resource.data) || request.resource.data.superAdmin == false);
    }
    function isPartnerPreRegistrationUpdateByInviter(targetUserId) {
      return request.auth != null &&
        request.auth.uid != targetUserId &&
        resource.data.partnerInviteStatus == 'pending' &&
        resource.data.invitedByUid == request.auth.uid &&
        request.resource.data.partnerInviteStatus == 'pending' &&
        request.resource.data.invitedByUid == request.auth.uid &&
        !('role' in request.resource.data) &&
        request.resource.data.roles is list &&
        request.resource.data.roles.hasOnly(['athlete']) &&
        request.resource.data.roles.size() > 0;
    }
    // ── Regra "nível só sobe" (anti-sandbagging) ─────────────────────────
    // O próprio atleta nunca reduz um nível já salvo — nem os legados
    // (`level`, `sportProfile.level`, que clientes antigos ainda escrevem)
    // nem o canônico por esporte (`sportOnboarding.levelsBySport`, única
    // escrita dos clientes novos). Downgrade só via super admin (suporte).
    // Primeira definição é livre (campo ausente/valor desconhecido →
    // rank -1); sobrescrever nível conhecido por valor inválido é bloqueado.
    // Escada única de 5 níveis para TODOS os esportes (Iniciante 1/2,
    // Intermediário 1/2, Open no rank 5 — rank 4 sem uso, numeração fixa por
    // compatibilidade com athleteRatings.levelRank). Legados se comportam
    // como o degrau inferior do split (iniciante→0, intermediario→2).
    // Lookup por map literal (barato) em vez de cadeias de `in` sobre listas:
    // a guarda roda para 9 esportes por update e a versão com ternários
    // estourava o limite de expressões avaliadas por request.
    function athleteLevelRank(value) {
      let ranks = {
        'iniciante': 0, 'Iniciante': 0, 'basico': 0, 'básico': 0,
        'Básico': 0, 'iniciante_1': 0, 'Iniciante 1': 0,
        'iniciante_2': 1, 'Iniciante 2': 1,
        'intermediario': 2, 'Intermediário': 2,
        'intermediario_1': 2, 'Intermediário 1': 2,
        'intermediario_2': 3, 'Intermediário 2': 3,
        'open': 5, 'Open': 5, 'livre': 5, 'Livre': 5, 'Open / federado': 5
      };
      return value is string ? ranks.get(value, -1) : -1;
    }
    function levelsBySportOf(data) {
      return data.get('sportOnboarding', {}).get('levelsBySport', {});
    }
    // Valor inalterado curto-circuita ANTES de rankear: só o campo que mudou
    // paga o custo do lookup (essencial para caber no limite de expressões).
    function levelNotLowered(reqValue, curValue) {
      return reqValue == curValue ||
        athleteLevelRank(reqValue) >= athleteLevelRank(curValue);
    }
    function sportLevelNotLowered(reqLevels, curLevels, sportId) {
      return levelNotLowered(
        reqLevels.get(sportId, null),
        curLevels.get(sportId, null)
      );
    }
    // Guarda TODOS os esportes do perfil (rules não iteram mapas — a lista
    // espelha ATHLETE_SPORT_CODES em functions/src/category-level-eligibility.ts
    // e AthleteFirestoreCodes no app) + os campos legados de nível global,
    // fallback do backend para docs antigos. Mapa inalterado curto-circuita
    // os 9 checks por esporte (caso comum: update sem mexer em nível).
    function athleteLevelsNotDowngraded() {
      let reqLevels = levelsBySportOf(request.resource.data);
      let curLevels = levelsBySportOf(resource.data);
      return levelNotLowered(
          request.resource.data.get('level', null),
          resource.data.get('level', null)
        ) &&
        levelNotLowered(
          request.resource.data.get('sportProfile', {}).get('level', null),
          resource.data.get('sportProfile', {}).get('level', null)
        ) &&
        (reqLevels == curLevels || (
          sportLevelNotLowered(reqLevels, curLevels, 'VOLEI_PRAIA') &&
          sportLevelNotLowered(reqLevels, curLevels, 'VOLEI_QUADRA') &&
          sportLevelNotLowered(reqLevels, curLevels, 'BEACH_TENNIS') &&
          sportLevelNotLowered(reqLevels, curLevels, 'FUTEVOLEI') &&
          sportLevelNotLowered(reqLevels, curLevels, 'FUTEBOL') &&
          sportLevelNotLowered(reqLevels, curLevels, 'BASQUETE') &&
          sportLevelNotLowered(reqLevels, curLevels, 'TENIS') &&
          sportLevelNotLowered(reqLevels, curLevels, 'CORRIDA') &&
          sportLevelNotLowered(reqLevels, curLevels, 'OUTROS')
        ));
    }
    function isArenaManagerByArenaId(arenaId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/arenas/$(arenaId)) &&
        get(/databases/$(database)/documents/arenas/$(arenaId)).data.managerUserId == request.auth.uid;
    }
    // ---- Equipe da arena (RBAC) ----------------------------------------
    // A matriz abaixo é ESPELHO MANUAL de
    // `frontend/projects/arena/src/app/painel/data/arena-roles.model.ts`.
    // Nada aqui verifica automaticamente que os dois ficam em sincronia — é
    // no olho, na revisão de código. As duas TAMBÉM divergem por design: o
    // frontend tem uma área `torneios` (gestor, somente leitura) que não
    // existe aqui, porque nenhum bloco de regra hoje é controlado por área
    // `torneios`.
    function isArenaOwner(arenaId) {
      return isArenaManagerByArenaId(arenaId);
    }
    function arenaStaffDoc(arenaId) {
      return get(/databases/$(database)/documents/arenas/$(arenaId)/staff/$(request.auth.uid)).data;
    }
    // Membro ativo E arena com titularidade de plano pago: plano vencido fora
    // da carência corta o acesso do membro no mesmo instante, sem sweeper.
    function isActiveArenaStaff(arenaId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/arenas/$(arenaId)/staff/$(request.auth.uid)) &&
        arenaStaffDoc(arenaId).get('status', '') == 'active' &&
        arenaEntitled(arenaId, ['pro', 'elite', 'parceiro']);
    }
    function arenaWriteAreas(role) {
      return {
        'gestor': ['agenda', 'comandas', 'estoque', 'promocoes', 'site', 'quadras', 'perfil', 'comunidade'],
        'recepcao': ['agenda', 'comandas'],
        'financeiro': ['promocoes'],
        'manutencao': ['quadras', 'estoque']
      }.get(role, []);
    }
    function arenaReadAreas(role) {
      return {
        'gestor': ['agenda', 'comandas', 'estoque', 'promocoes', 'site', 'quadras', 'perfil', 'comunidade', 'financeiro'],
        'recepcao': ['agenda', 'comandas', 'comunidade', 'estoque'],
        'financeiro': ['financeiro', 'promocoes', 'comandas', 'comunidade'],
        'manutencao': ['quadras', 'estoque', 'agenda']
      }.get(role, []);
    }
    function arenaCanWrite(arenaId, area) {
      return isArenaOwner(arenaId) || (
        isActiveArenaStaff(arenaId) &&
        arenaWriteAreas(arenaStaffDoc(arenaId).get('role', '')).hasAny([area])
      );
    }
    function arenaCanRead(arenaId, area) {
      return isArenaOwner(arenaId) || (
        isActiveArenaStaff(arenaId) &&
        arenaReadAreas(arenaStaffDoc(arenaId).get('role', '')).hasAny([area])
      );
    }
    function canManageArenaProducts(arenaId) {
      return request.auth != null && (
        arenaCanWrite(arenaId, 'estoque') ||
        isSuperAdmin()
      );
    }
    // Gate de plano (titularidade): a arena tem acesso pago em um dos [tiers]
    // AGORA. Deriva de data, não do flag cru — espelha ArenaPlanStatus.entitled:
    //  - active: sim;
    //  - overdue: sim enquanto dentro da carência de 7 dias após o vencimento;
    //  - canceling: sim até o fim do período pago (planActiveUntil);
    //  - demais (none/refund/chargeback): não.
    // planStatus/planTier/planActiveUntil só são gravados pelas Cloud Functions
    // (o gestor não se auto-promove), então é seguro confiar neles aqui.
    function arenaEntitled(arenaId, tiers) {
      let a = get(/databases/$(database)/documents/arenas/$(arenaId)).data;
      let status = a.get('planStatus', 'none');
      let until = a.get('planActiveUntil', null);
      return (a.get('planTier', '') in tiers) && (
        status == 'active' ||
        (status == 'overdue' && until != null &&
          request.time < until + duration.value(7, 'd')) ||
        (status == 'canceling' && until != null && request.time < until)
      );
    }
    // Limite de quadras por plano: sem plano/Starter até 2; Pro até 5;
    // Elite/Parceiro (legado) ilimitado. courtsCount é mantido por Cloud
    // Function (arena-courts-count.ts) — as rules não contam documentos.
    function arenaCanAddCourt(arenaId) {
      return arenaEntitled(arenaId, ['parceiro', 'elite']) ||
        (arenaEntitled(arenaId, ['pro']) &&
          get(/databases/$(database)/documents/arenas/$(arenaId)).data.get('courtsCount', 0) < 5) ||
        get(/databases/$(database)/documents/arenas/$(arenaId)).data.get('courtsCount', 0) < 2;
    }
    function isValidArenaProductCategory(category) {
      return category in ['bebidas', 'alimentacao', 'equipamentos', 'servicos'];
    }
    function isValidArenaProductData(data) {
      return data.name is string &&
        data.name.size() > 0 &&
        data.name.size() <= 120 &&
        data.nameLower is string &&
        data.nameLower.size() > 0 &&
        isValidArenaProductCategory(data.category) &&
        data.active is bool &&
        data.priceCents is int &&
        data.priceCents >= 0 &&
        data.priceCents <= 100000000 &&
        data.stockQuantity is int &&
        data.stockQuantity >= 0 &&
        data.stockQuantity <= 1000000 &&
        data.minStockQuantity is int &&
        data.minStockQuantity >= 0 &&
        data.minStockQuantity <= 1000000 &&
        (!('description' in data) || data.description == null || (data.description is string && data.description.size() <= 500)) &&
        (!('emoji' in data) || data.emoji == null || (data.emoji is string && data.emoji.size() <= 8)) &&
        (!('imageUrl' in data) || data.imageUrl == null || (data.imageUrl is string && data.imageUrl.size() <= 2048));
    }
    function isValidArenaStockMovementType(movementType) {
      return movementType in ['purchase', 'adjustment', 'loss', 'sale'];
    }
    function isValidArenaStockMovementCreate(arenaId, productId) {
      let productDoc = get(/databases/$(database)/documents/arenas/$(arenaId)/products/$(productId));
      let data = request.resource.data;
      return canManageArenaProducts(arenaId) &&
        productDoc.data != null &&
        data.keys().hasAll([
          'productId',
          'productName',
          'type',
          'quantityDelta',
          'quantityBefore',
          'quantityAfter',
          'createdAt',
          'createdByUid'
        ]) &&
        data.productId == productId &&
        data.productName is string &&
        data.productName.size() > 0 &&
        isValidArenaStockMovementType(data.type) &&
        isFirestoreInt(data.quantityDelta) &&
        firestoreIntValue(data.quantityDelta) != 0 &&
        isFirestoreInt(data.quantityBefore) &&
        firestoreIntValue(data.quantityBefore) >= 0 &&
        isFirestoreInt(data.quantityAfter) &&
        firestoreIntValue(data.quantityAfter) >= 0 &&
        firestoreIntValue(data.quantityAfter) ==
          firestoreIntValue(data.quantityBefore) +
          firestoreIntValue(data.quantityDelta) &&
        (
          firestoreIntValue(data.quantityBefore) == arenaProductStockQty(productDoc) ||
          firestoreIntValue(data.quantityAfter) == arenaProductStockQty(productDoc)
        ) &&
        isCreateTimestamp(data.createdAt) &&
        data.createdByUid == request.auth.uid &&
        (!('note' in data) || data.note == null || (data.note is string && data.note.size() <= 300));
    }
    function isValidArenaComandaStatus(status) {
      return status in ['open', 'closing', 'partiallyPaid', 'closed'];
    }
    function isValidArenaComandaType(type) {
      return type in ['shared', 'individual', 'table', 'event'];
    }
    function isValidArenaComandaCreate(data) {
      return data.keys().hasAll([
          'arenaId',
          'displayNumber',
          'type',
          'status',
          'customerName',
          'allowAppOrders',
          'rentalCents',
          'itemsTotalCents',
          'totalCents',
          'itemsCount',
          'openedByUid',
          'openedAt',
          'createdAt',
          'updatedAt'
        ]) &&
        data.arenaId is string &&
        data.arenaId.size() > 0 &&
        arenaCanWrite(data.arenaId, 'comandas') &&
        data.displayNumber is int &&
        data.displayNumber > 0 &&
        data.displayNumber <= 999999 &&
        isValidArenaComandaType(data.type) &&
        data.type == 'individual' &&
        data.status == 'open' &&
        data.customerName is string &&
        data.customerName.size() > 0 &&
        data.customerName.size() <= 120 &&
        data.allowAppOrders is bool &&
        data.rentalCents is int &&
        data.rentalCents >= 0 &&
        data.rentalCents <= 100000000 &&
        data.itemsTotalCents is int &&
        data.itemsTotalCents == 0 &&
        data.totalCents is int &&
        data.totalCents == data.rentalCents &&
        data.itemsCount is int &&
        data.itemsCount == 0 &&
        (!('paidCents' in data) || (data.paidCents is int && data.paidCents == 0)) &&
        data.openedByUid == request.auth.uid &&
        data.openedAt is timestamp &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        (!('bookingId' in data) || data.bookingId == null || (data.bookingId is string && data.bookingId.size() <= 128)) &&
        (!('bookingDisplayCode' in data) || data.bookingDisplayCode == null || (data.bookingDisplayCode is string && data.bookingDisplayCode.size() <= 32)) &&
        (!('locationLabel' in data) || data.locationLabel == null || (data.locationLabel is string && data.locationLabel.size() <= 120)) &&
        (!('customerWhatsapp' in data) || data.customerWhatsapp == null || (data.customerWhatsapp is string && data.customerWhatsapp.size() <= 32)) &&
        (!('customerCpf' in data) || data.customerCpf == null || (data.customerCpf is string && data.customerCpf.size() <= 14));
    }
    function isValidArenaComandaItemSource(source) {
      return source in ['counter', 'app'];
    }
    function isValidArenaComandaPaymentMethod(method) {
      return method in ['pix', 'credit', 'debit', 'cash', 'wallet', 'other'];
    }
    function arenaComandaPaidCents(data) {
      return 'paidCents' in data && data.paidCents is int
        ? data.paidCents
        : (
            'paidCents' in data && data.paidCents is number
              ? int(data.paidCents)
              : 0
          );
    }
    function arenaComandaRentalCents(data) {
      return 'rentalCents' in data && data.rentalCents is int
        ? data.rentalCents
        : (
            'rentalCents' in data && data.rentalCents is number
              ? int(data.rentalCents)
              : 0
          );
    }
    function arenaProductStockQty(productDoc) {
      return productDoc.data.stockQuantity is int
        ? productDoc.data.stockQuantity
        : (
            productDoc.data.stockQuantity is number
              ? int(productDoc.data.stockQuantity)
              : 0
          );
    }
    function isValidArenaProductStockUpdate() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'stockQuantity',
          'updatedAt'
        ]) &&
        isFirestoreInt(request.resource.data.stockQuantity) &&
        firestoreIntValue(request.resource.data.stockQuantity) >= 0 &&
        firestoreIntValue(request.resource.data.stockQuantity) <= 1000000 &&
        (
          request.resource.data.updatedAt is timestamp ||
          request.resource.data.updatedAt == request.time
        );
    }
    function arenaComandaStatusValue(data) {
      return data.status is string ? data.status : 'open';
    }
    function isCreateTimestamp(value) {
      return value is timestamp || value == request.time;
    }
    function isFirestoreInt(value) {
      return value is int || (value is number && value == int(value));
    }
    function firestoreIntValue(value) {
      return value is int ? value : int(value);
    }
    function comandaPaymentStateChanged() {
      return arenaComandaStatusValue(request.resource.data) !=
          arenaComandaStatusValue(resource.data) ||
        arenaComandaPaidCents(request.resource.data) !=
          arenaComandaPaidCents(resource.data);
    }
    function isValidArenaComandaItemCreate(comandaId, data) {
      let comandaDoc = get(/databases/$(database)/documents/arenaComandas/$(comandaId));
      return comandaDoc.data != null &&
        (arenaCanWrite(comandaDoc.data.arenaId, 'comandas') || isSuperAdmin()) &&
        data.keys().hasAll([
          'productId',
          'productName',
          'quantity',
          'unitPriceCents',
          'lineTotalCents',
          'source',
          'addedByName',
          'addedByUid',
          'createdAt'
        ]) &&
        data.productId is string &&
        data.productId.size() > 0 &&
        data.productName is string &&
        data.productName.size() > 0 &&
        data.productName.size() <= 120 &&
        isFirestoreInt(data.quantity) &&
        firestoreIntValue(data.quantity) > 0 &&
        firestoreIntValue(data.quantity) <= 99 &&
        isFirestoreInt(data.unitPriceCents) &&
        firestoreIntValue(data.unitPriceCents) >= 0 &&
        firestoreIntValue(data.unitPriceCents) <= 100000000 &&
        isFirestoreInt(data.lineTotalCents) &&
        firestoreIntValue(data.lineTotalCents) ==
          firestoreIntValue(data.unitPriceCents) * firestoreIntValue(data.quantity) &&
        isValidArenaComandaItemSource(data.source) &&
        data.addedByName is string &&
        data.addedByName.size() > 0 &&
        data.addedByName.size() <= 120 &&
        data.addedByUid == request.auth.uid &&
        isCreateTimestamp(data.createdAt) &&
        (!('emoji' in data) || data.emoji == null || (data.emoji is string && data.emoji.size() <= 16));
    }
    function isValidArenaComandaItemDelete(comandaId) {
      let comandaDoc = get(/databases/$(database)/documents/arenaComandas/$(comandaId));
      let status = arenaComandaStatusValue(comandaDoc.data);
      return comandaDoc.data != null &&
        (arenaCanWrite(comandaDoc.data.arenaId, 'comandas') || isSuperAdmin()) &&
        status in ['open', 'closing', 'partiallyPaid'];
    }
    function isValidArenaComandaPaymentCreate(comandaId, data) {
      let comandaDoc = get(/databases/$(database)/documents/arenaComandas/$(comandaId));
      return comandaDoc.data != null &&
        (arenaCanWrite(comandaDoc.data.arenaId, 'comandas') || isSuperAdmin()) &&
        data.keys().hasAll([
          'method',
          'amountCents',
          'payerName',
          'receivedByUid',
          'createdAt'
        ]) &&
        isValidArenaComandaPaymentMethod(data.method) &&
        data.amountCents is int &&
        data.amountCents > 0 &&
        data.amountCents <= 100000000 &&
        data.payerName is string &&
        data.payerName.size() > 0 &&
        data.payerName.size() <= 120 &&
        data.receivedByUid == request.auth.uid &&
        isCreateTimestamp(data.createdAt);
    }
    function isValidArenaComandaUpdate() {
      return         request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'status',
          'itemsTotalCents',
          'totalCents',
          'itemsCount',
          'paidCents',
          'rentalCents',
          'updatedAt'
        ]) &&
        isValidArenaComandaStatus(
          arenaComandaStatusValue(request.resource.data)
        ) &&
        request.resource.data.itemsTotalCents is int &&
        request.resource.data.itemsTotalCents >= 0 &&
        request.resource.data.totalCents is int &&
        request.resource.data.totalCents ==
          arenaComandaRentalCents(resource.data) +
          request.resource.data.itemsTotalCents &&
        request.resource.data.itemsCount is int &&
        request.resource.data.itemsCount >= 0 &&
        (
          request.resource.data.updatedAt is timestamp ||
          request.resource.data.updatedAt == request.time
        ) &&
        (
          !comandaPaymentStateChanged() ||
          (
            arenaComandaPaidCents(request.resource.data) >= 0 &&
            arenaComandaPaidCents(request.resource.data) <=
              request.resource.data.totalCents &&
            (
              arenaComandaStatusValue(request.resource.data) == 'closed'
                ? arenaComandaPaidCents(request.resource.data) >=
                  request.resource.data.totalCents
                : true
            ) &&
            (
              arenaComandaStatusValue(request.resource.data) == 'partiallyPaid'
                ? arenaComandaPaidCents(request.resource.data) > 0 &&
                  arenaComandaPaidCents(request.resource.data) <
                    request.resource.data.totalCents
                : true
            )
          )
        );
    }

    // Regras para arenas
    match /arenas/{arenaId} {
      allow read: if true;
      // Campos de plano definem preço (taxa por reserva, tarifa de saque) e
      // capabilities: nascer com planTier já valeria plano Elite de graça.
      // Só as Cloud Functions os gravam (Admin SDK ignora rules), então o
      // create do cliente tem de vir SEM eles — inclusive para admins, que não
      // têm por que assinar plano pela UI.
      allow create: if request.auth != null &&
        (isAdmin() || isSuperAdmin() || isArena()) &&
        !request.resource.data.keys().hasAny(['planTier', 'planStatus', 'planActiveUntil']);
      // Campos de plano (planTier/planStatus/planActiveUntil) só as Cloud Functions
      // gravam (Admin SDK ignora rules); o gestor não pode se auto-promover.
      // payoutPixKey/payoutPixKeyType/paymentReceiver definem para onde vai o
      // dinheiro do saque da arena: cargo nenhum (nem o gestor, que só tem
      // acesso de LEITURA ao financeiro) pode trocá-los — só o dono. O dono
      // segue liberado (inclusive o app Flutter, que reenvia paymentReceiver
      // a cada edição de perfil), então o freeze desses três só vale para
      // quem não é dono.
      allow update: if request.auth != null && (
        isAdmin() || isSuperAdmin() || (
          arenaCanWrite(arenaId, 'perfil') &&
          request.resource.data.get('planTier', null) == resource.data.get('planTier', null) &&
          request.resource.data.get('planStatus', null) == resource.data.get('planStatus', null) &&
          request.resource.data.get('planActiveUntil', null) == resource.data.get('planActiveUntil', null) &&
          request.resource.data.get('managerUserId', '') == resource.data.get('managerUserId', '') &&
          (
            isArenaOwner(arenaId) || (
              request.resource.data.get('payoutPixKey', null) == resource.data.get('payoutPixKey', null) &&
              request.resource.data.get('payoutPixKeyType', null) == resource.data.get('payoutPixKeyType', null) &&
              request.resource.data.get('paymentReceiver', null) == resource.data.get('paymentReceiver', null)
            )
          )
        )
      );
      allow delete: if request.auth != null && (
        resource.data.managerUserId == request.auth.uid ||
        isAdmin() ||
        isSuperAdmin()
      );
    }
    // Equipe da arena. Escrita SEMPRE via Cloud Function: criar vínculo exige
    // contar assentos e conferir plano, coisas que rules não fazem.
    match /arenas/{arenaId}/staff/{staffUserId} {
      allow read: if request.auth != null && (
        isArenaOwner(arenaId) ||
        request.auth.uid == staffUserId ||
        isAdmin() ||
        isSuperAdmin()
      );
      allow write: if false;
    }
    // Cobrança/assinatura da arena — leitura restrita ao gestor/admin; escrita só via functions.
    match /arenas/{arenaId}/billing/{docId} {
      allow read: if request.auth != null && (
        get(/databases/$(database)/documents/arenas/$(arenaId)).data.managerUserId == request.auth.uid ||
        isAdmin() ||
        isSuperAdmin()
      );
      allow write: if false;
    }
    match /arenas/{arenaId}/asaas/{docId} {
      allow read: if request.auth != null && (
        get(/databases/$(database)/documents/arenas/$(arenaId)).data.managerUserId == request.auth.uid ||
        isAdmin() ||
        isSuperAdmin()
      );
      allow write: if false;
    }
    match /arenas/{arenaId}/courts/{courtId} {
      allow read: if true;
      allow create: if request.auth != null && (
        (arenaCanWrite(arenaId, 'quadras') && arenaCanAddCourt(arenaId)) ||
        isSuperAdmin()
      );
      allow update, delete: if request.auth != null && (
        arenaCanWrite(arenaId, 'quadras') ||
        isSuperAdmin()
      );
    }
    match /arenas/{arenaId}/followers/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.arenaId == arenaId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    match /arenas/{arenaId}/promotions/{promoId} {
      allow read: if true;
      // Criar/editar promoção exige titularidade Pro. Sem ela o gestor não
      // reativa nem cria; o sweeper (Cloud Function) pausa as ativas. Excluir
      // segue liberado para limpeza.
      allow create, update: if request.auth != null && (
        arenaCanWrite(arenaId, 'promocoes') ||
        isSuperAdmin()
      ) && (isSuperAdmin() || arenaEntitled(arenaId, ['pro', 'parceiro', 'elite']));
      allow delete: if request.auth != null && (
        arenaCanWrite(arenaId, 'promocoes') ||
        isSuperAdmin()
      );
    }
    match /arenas/{arenaId}/coupons/{couponId} {
      // Cupom de marketing (código + validade + limite de uso) — complementar
      // às `promotions` acima. Escrita só via Cloud Functions
      // (`arena-coupons.ts`, mesmo padrão de `arenaWallets`): precisa
      // validar vigência/limites/XOR de desconto e gravar resgates de forma
      // atômica, o que uma regra de segurança não garante sozinha.
      allow read: if request.auth != null && (
        isSuperAdmin() ||
        arenaCanRead(arenaId, 'promocoes')
      );
      allow write: if false;
      match /redemptions/{athleteId} {
        allow read: if request.auth != null && (
          isSuperAdmin() ||
          arenaCanRead(arenaId, 'promocoes') ||
          request.auth.uid == athleteId
        );
        allow write: if false;
      }
    }
    match /arenaWallets/{arenaId} {
      allow read: if request.auth != null && (
        isSuperAdmin() ||
        isAdmin() ||
        arenaCanRead(arenaId, 'financeiro')
      );
      allow create, update, delete: if false;
      match /ledger/{entryId} {
        allow read: if request.auth != null && (
          isSuperAdmin() ||
          isAdmin() ||
          arenaCanRead(arenaId, 'financeiro')
        );
        allow create, update, delete: if false;
      }
    }
    // Feed da Comunidade — itens gerados pelo sistema; escrita só via Cloud Functions.
    match /communityFeed/{itemId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /organizerWallets/{organizerId} {
      // Carteira do organizador (id = uid). Escrita só pelas Cloud Functions.
      allow read: if request.auth != null && (
        isSuperAdmin() ||
        isAdmin() ||
        request.auth.uid == organizerId
      );
      allow create, update, delete: if false;
      match /ledger/{entryId} {
        allow read: if request.auth != null && (
          isSuperAdmin() ||
          isAdmin() ||
          request.auth.uid == organizerId
        );
        allow create, update, delete: if false;
      }
    }
    match /arenaWithdrawals/{withdrawalId} {
      allow read: if request.auth != null && (
        isSuperAdmin() ||
        isAdmin() ||
        (resource != null && arenaCanRead(resource.data.arenaId, 'financeiro'))
      );
      allow create: if false;
      allow update: if request.auth != null && (isSuperAdmin() || isAdmin());
      allow delete: if false;
    }
    // Convites de equipe. Lidos pelo dono e por quem tem o e-mail convidado
    // (a rota /convite precisa ler antes de aceitar). Escrita só via function.
    match /arenaStaffInvites/{inviteId} {
      allow read: if request.auth != null && (
        isArenaOwner(resource.data.arenaId) ||
        (
          // Os dois lados TÊM de ser não-vazios: com os defaults de `get`,
          // '' == '' daria leitura a qualquer sessão sem e-mail (phone/anônima)
          // sobre qualquer convite malformado sem `emailLower`.
          resource.data.get('emailLower', '') != '' &&
          request.auth.token.get('email', '') != '' &&
          request.auth.token.email.lower() == resource.data.emailLower
        ) ||
        isAdmin() ||
        isSuperAdmin()
      );
      allow write: if false;
    }
    match /organizerWithdrawals/{withdrawalId} {
      // Criação/pagamento só pelas Cloud Functions; organizador só lê os seus.
      allow read: if request.auth != null && (
        isSuperAdmin() ||
        isAdmin() ||
        (resource != null && resource.data.organizerId == request.auth.uid)
      );
      allow create: if false;
      allow update: if request.auth != null && (isSuperAdmin() || isAdmin());
      allow delete: if false;
    }
    match /arenas/{arenaId}/products/{productId} {
      // Leitura aberta a qualquer usuário autenticado: é o cardápio/catálogo
      // que o atleta vê no "Peça na quadra" (não é dado sensível, mesmo nível
      // de exposição de arenas/{arenaId}/courts e /promotions, só que exige
      // login). Escrita (criar/editar/repor/excluir) continua só do gestor.
      allow read: if request.auth != null;
      allow create: if canManageArenaProducts(arenaId) &&
        (isSuperAdmin() || arenaEntitled(arenaId, ['pro', 'parceiro', 'elite'])) &&
        isValidArenaProductData(request.resource.data) &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.updatedAt is timestamp;
      // Editar/repor produto exige titularidade Pro; sem ela o catálogo fica
      // read-only (delete segue liberado para limpeza).
      allow update: if canManageArenaProducts(arenaId) &&
        (isSuperAdmin() || arenaEntitled(arenaId, ['pro', 'parceiro', 'elite'])) && (
        isValidArenaProductStockUpdate() ||
        (
          isValidArenaProductData(request.resource.data) &&
          request.resource.data.updatedAt is timestamp &&
          request.resource.data.createdAt == resource.data.createdAt
        )
      );
      allow delete: if canManageArenaProducts(arenaId);
    }
    match /arenas/{arenaId}/sales/{saleId} {
      allow read: if request.auth != null && (arenaCanRead(arenaId, 'comandas') || isSuperAdmin());
      allow create: if request.auth != null && (arenaCanWrite(arenaId, 'comandas') || isSuperAdmin());
      allow update, delete: if false;
    }
    match /arenas/{arenaId}/stockMovements/{movementId} {
      allow read: if request.auth != null && (arenaCanRead(arenaId, 'estoque') || isSuperAdmin());
      allow create: if (isSuperAdmin() || arenaEntitled(arenaId, ['pro', 'parceiro', 'elite'])) &&
        isValidArenaStockMovementCreate(
          arenaId,
          request.resource.data.productId
        );
      allow update, delete: if false;
    }
    match /arenas/{arenaId}/metadata/{docId} {
      allow read: if request.auth != null && (arenaCanRead(arenaId, 'comandas') || isSuperAdmin());
      allow create, update: if docId == 'comandaCounter' &&
        request.auth != null && (arenaCanWrite(arenaId, 'comandas') || isSuperAdmin()) &&
        request.resource.data.keys().hasAll(['lastNumber', 'updatedAt']) &&
        request.resource.data.lastNumber is int &&
        request.resource.data.lastNumber > 0 &&
        request.resource.data.lastNumber <= 999999 &&
        request.resource.data.updatedAt is timestamp &&
        (
          resource == null ||
          request.resource.data.lastNumber == resource.data.lastNumber + 1
        );
      allow delete: if false;
    }
    // Dono da comanda pelo lado do atleta (Peça na quadra / pedido pelo
    // app): hoje só existe elo comanda→atleta quando a comanda foi aberta
    // vinculada a uma reserva (bookingId) — comandas "sem vínculo" (walk-in,
    // cliente que não é usuário do app) não têm dono identificável aqui.
    // Escrita em items/payments continua vedada ao client mesmo para o
    // dono: só a Cloud Function addAppOrderItem grava (Admin SDK).
    function isArenaComandaOwnerAthlete(comandaData) {
      let bookingId = comandaData.get('bookingId', null);
      return bookingId != null &&
        exists(/databases/$(database)/documents/arenaBookings/$(bookingId)) &&
        get(/databases/$(database)/documents/arenaBookings/$(bookingId)).data.athleteId == request.auth.uid;
    }
    match /arenaComandas/{comandaId} {
      allow read: if request.auth != null && (
        isSuperAdmin() ||
        (resource != null && arenaCanRead(resource.data.arenaId, 'comandas')) ||
        (resource != null && isArenaComandaOwnerAthlete(resource.data))
      );
      allow create: if request.auth != null &&
        isValidArenaComandaCreate(request.resource.data) &&
        (
          isSuperAdmin() ||
          arenaEntitled(request.resource.data.arenaId, ['pro', 'parceiro', 'elite'])
        );
      allow update: if request.auth != null && (
        isSuperAdmin() ||
        arenaCanWrite(resource.data.arenaId, 'comandas')
      ) && isValidArenaComandaUpdate();
      allow delete: if false;
      match /items/{itemId} {
        allow read: if request.auth != null && (
          isSuperAdmin() ||
          arenaCanRead(
            get(/databases/$(database)/documents/arenaComandas/$(comandaId)).data.arenaId,
            'comandas'
          ) ||
          isArenaComandaOwnerAthlete(
            get(/databases/$(database)/documents/arenaComandas/$(comandaId)).data
          )
        );
        // Adicionar item exige titularidade Pro: uma arena que caiu pro
        // Essencial (downgrade) fica read-only, mas ainda pode fechar/receber a
        // comanda (update + payment abaixo continuam liberados).
        allow create: if request.auth != null &&
          isValidArenaComandaItemCreate(comandaId, request.resource.data) &&
          (
            isSuperAdmin() ||
            arenaEntitled(
              get(/databases/$(database)/documents/arenaComandas/$(comandaId)).data.arenaId,
              ['pro', 'parceiro', 'elite']
            )
          );
        allow delete: if request.auth != null &&
          isValidArenaComandaItemDelete(comandaId);
        allow update: if false;
      }
      match /payments/{paymentId} {
        allow read: if request.auth != null && (
          isSuperAdmin() ||
          arenaCanRead(
            get(/databases/$(database)/documents/arenaComandas/$(comandaId)).data.arenaId,
            'comandas'
          ) ||
          isArenaComandaOwnerAthlete(
            get(/databases/$(database)/documents/arenaComandas/$(comandaId)).data
          )
        );
        allow create: if request.auth != null &&
          isValidArenaComandaPaymentCreate(comandaId, request.resource.data);
        allow update, delete: if false;
      }
    }
    match /arenaSlots/{slotId} {
      allow read: if true;
      allow create: if request.auth != null && (
        isSuperAdmin() ||
        arenaCanWrite(request.resource.data.arenaId, 'agenda')
      );
      allow update: if request.auth != null && (
        isSuperAdmin() ||
        arenaCanWrite(resource.data.arenaId, 'agenda')
      );
      allow delete: if request.auth != null && (
        isSuperAdmin() ||
        arenaCanWrite(resource.data.arenaId, 'agenda')
      );
    }

    // Reservas criadas pelo app NexaGO (atleta): um documento por slot.
    match /bookings/{bookingId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.arenaId is string &&
        request.resource.data.slotId is string &&
        request.resource.data.status == 'pending' &&
        request.resource.data.paymentType == 'local';
      allow update, delete: if false;
    }
    match /arenaSlotLocks/{lockId} {
      allow read: if true;
      allow create: if request.auth != null && (
        isSuperAdmin() ||
        arenaCanWrite(request.resource.data.arenaId, 'agenda')
      );
      allow update, delete: if request.auth != null && (
        isSuperAdmin() ||
        arenaCanWrite(resource.data.arenaId, 'agenda')
      );
    }
    // Links curtos de convite (crescimento viral): leitura pública com dados mínimos da reserva
    match /arenaBookingInvites/{shareCode} {
      allow read: if true;
      allow create: if request.auth != null
        && shareCode.size() >= 6
        && shareCode.size() <= 12
        && request.resource.data.keys().hasAll([
          'bookingId', 'arenaId', 'arenaName', 'courtName', 'date', 'startTime', 'endTime', 'amountReais', 'courtCapacity'
        ])
        && request.resource.data.bookingId is string
        && request.resource.data.arenaId is string
        && request.resource.data.arenaName is string
        && request.resource.data.courtName is string
        && request.resource.data.date is string
        && request.resource.data.startTime is string
        && request.resource.data.endTime is string
        && request.resource.data.amountReais is number
        && (
          request.resource.data.courtCapacity == null ||
          (request.resource.data.courtCapacity is int && request.resource.data.courtCapacity >= 0)
        )
        && exists(/databases/$(database)/documents/arenaBookings/$(request.resource.data.bookingId))
        && get(/databases/$(database)/documents/arenaBookings/$(request.resource.data.bookingId)).data.athleteId == request.auth.uid
        && get(/databases/$(database)/documents/arenaBookings/$(request.resource.data.bookingId)).data.arenaId == request.resource.data.arenaId;
      allow update, delete: if false;
    }

    match /arenaBookings/{bookingId} {
      // Leitura autenticada ampla: o preview do convite compartilhado
      // (/convite/:inviteId) relê a reserva ANTES de o convidado ter vínculo
      // com ela (fetchInvite). Era o comportamento efetivo com o catch-all
      // antigo; apertar exige repensar o preview do convite primeiro.
      allow read: if request.auth != null;
      allow create: if request.auth != null && (
        isSuperAdmin() ||
        arenaCanWrite(request.resource.data.arenaId, 'agenda')
      );
      allow update: if request.auth != null && (
        resource.data.athleteId == request.auth.uid ||
        arenaCanWrite(resource.data.arenaId, 'agenda') ||
        isSuperAdmin() ||
        // Convidado aceitando convite de reserva (bookingInvites): só pode
        // tocar os campos de participação — nunca status/pagamento.
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['confirmedParticipants', 'guestAthleteId', 'guestAthleteName']
        )
      );
      allow delete: if false;

      // Split de pagamento: fatia PIX de um convidado. Só o próprio pagador
      // ou o dono da reserva leem; escrita é sempre via Cloud Function
      // (Admin SDK) — cria a cobrança Asaas antes de gravar o doc.
      match /paymentShares/{shareId} {
        allow read: if request.auth != null && (
          resource.data.payerAthleteId == request.auth.uid ||
          get(/databases/$(database)/documents/arenaBookings/$(bookingId)).data.athleteId
            == request.auth.uid ||
          isSuperAdmin()
        );
        allow write: if false;
      }
    }

    // Lista de espera de horário de quadra lotado (domínio distinto da lista
    // de espera de INSCRIÇÃO em torneio). Só o próprio atleta e o gestor da
    // arena podem ler; toda escrita é feita pelas Cloud Functions
    // (joinArenaBookingWaitlist / notifyArenaWaitlistOnSlotFreed /
    // expireArenaBookingWaitlistEntries) — client nunca escreve direto.
    match /arenaBookingWaitlist/{waitlistId} {
      allow read: if request.auth != null && (
        resource.data.athleteId == request.auth.uid ||
        arenaCanRead(resource.data.arenaId, 'agenda') ||
        isSuperAdmin()
      );
      allow write: if false;
    }

    // Convites de reserva ("Convite para jogar" via link compartilhado).
    // Antes não havia regra: a leitura vazava pelo catch-all e a escrita
    // client-side (criar/aceitar) era NEGADA — o fluxo estava quebrado.
    match /bookingInvites/{inviteId} {
      // O destinatário é desconhecido até aceitar (link compartilhado).
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.resource.data.invitedByUid == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.bookingId is string &&
        request.resource.data.expiresAt is timestamp;
      // Aceite: transição única pending→accepted, aceitante se identifica e
      // não pode alterar o convite em si.
      allow update: if request.auth != null &&
        resource.data.status == 'pending' &&
        request.resource.data.status == 'accepted' &&
        request.resource.data.acceptedByUid == request.auth.uid &&
        request.resource.data.bookingId == resource.data.bookingId &&
        request.resource.data.invitedByUid == resource.data.invitedByUid;
      allow delete: if false;
    }

    // Horários fixos (mensalistas): série semanal criada pelo gestor.
    // Escrita apenas via Cloud Functions (Admin SDK) — a criação exige
    // transação com locks e validação de conflito multi-data.
    match /arenaRecurringBookings/{seriesId} {
      allow read: if request.auth != null && (
        resource.data.athleteId == request.auth.uid ||
        arenaCanRead(resource.data.arenaId, 'agenda') ||
        isSuperAdmin()
      );
      allow create, update, delete: if false;
    }

    // Clubinho — jogo aberto da arena (lista pública + PIX por sessão).
    // Escrita 100% via Cloud Functions: criação exige gate de plano
    // (Pro/Elite), bloqueio de agenda com locks e contadores de vaga em
    // transação; pagamento/estorno passam pelo Asaas.
    match /arenaClubs/{clubId} {
      allow read: if request.auth != null;
      allow create, update, delete: if false;
    }
    match /arenaClubSessions/{sessionId} {
      allow read: if request.auth != null;
      allow create, update, delete: if false;

      // A lista visível de nomes É o produto (como no grupo de WhatsApp).
      match /clubParticipants/{athleteId} {
        allow read: if request.auth != null;
        allow create, update, delete: if false;
      }
    }
    // Collection group "meus clubinhos": o atleta lê só as próprias inscrições.
    match /{path=**}/clubParticipants/{athleteId} {
      allow read: if request.auth != null &&
        resource.data.athleteId == request.auth.uid;
      allow create, update, delete: if false;
    }

    // Bloqueio de atleta por arena (gestor -> arena_blocks/{arenaId}_{athleteId})
    match /arena_blocks/{blockId} {
      allow read: if request.auth != null && (
        isSuperAdmin() ||
        (
          resource != null &&
          resource.data.arenaId is string &&
          arenaCanRead(resource.data.arenaId, 'agenda')
        )
      );

      allow create, update: if request.auth != null && (
        isSuperAdmin() ||
        (
          request.resource.data.arenaId is string &&
          request.resource.data.athleteId is string &&
          request.resource.data.reason is string &&
          request.resource.data.reason.size() > 0 &&
          request.resource.data.reason.size() <= 500 &&
          arenaCanWrite(request.resource.data.arenaId, 'agenda')
        )
      );

      allow delete: if request.auth != null && (
        isSuperAdmin() ||
        (
          resource != null &&
          resource.data.arenaId is string &&
          arenaCanWrite(resource.data.arenaId, 'agenda')
        )
      );
    }

    // Regras para a coleção de usuários
    // Espelho público de perfis SEM PII (nome, apelido, foto, cidade,
    // keywords) — mantido por Cloud Function (onUserWrittenSyncPublicProfile).
    // É o diretório do app: busca de parceiro, ranking, equipes.
    match /public_profiles/{userId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /users/{userId} {
      // Perfis de atletas são visíveis apenas para usuários AUTENTICADOS
      // (busca de parceiro, ranking, equipe). Sem login não há leitura: o doc
      // contém PII (email, telefone, nascimento) e leitura pública permitia
      // scraping em massa.
      // PLANO (após rollout do app que lê public_profiles): remover o ramo
      // userDocIsPublicAthlete abaixo, deixando owner/admin/convite pendente —
      // apps antigos ainda leem `users` para busca/ranking, então NÃO apertar
      // antes da adoção da versão nova.
      allow read: if request.auth != null && (
        (resource != null && userDocIsPublicAthlete(resource)) ||
        request.auth.uid == userId ||
        isAdmin() ||
        (
          resource.data.partnerInviteStatus == 'pending' &&
          resource.data.invitedByUid == request.auth.uid
        )
      );
      
      // Criar: próprio usuário, admin ou pré-cadastro de parceiro (inscrição)
      allow create: if request.auth != null && (
        (
          request.auth.uid == userId &&
          !('role' in request.resource.data) &&
          request.resource.data.roles is list &&
          request.resource.data.roles.hasOnly(['athlete']) &&
          request.resource.data.roles.size() > 0 &&
          (!('superAdmin' in request.resource.data) || request.resource.data.superAdmin == false) &&
          // Reputação (Bora Jogar) é derivada por Cloud Function — usuário
          // novo não pode nascer com reputação pré-fabricada.
          !('reputation' in request.resource.data) &&
          // Vínculo do programa de indicação (referral) só é gravado pela
          // Cloud Function `registerReferral` (idempotente, valida
          // auto-indicação) — o client não pode se auto-declarar indicado.
          !('referredBy' in request.resource.data) &&
          // Telefone verificado (SMS via Firebase Phone Auth) só é gravado
          // pela Cloud Function `confirmPhoneVerification` — usuário novo
          // não pode nascer já com telefone verificado.
          !('phoneNumber' in request.resource.data) &&
          !('phoneVerified' in request.resource.data) &&
          !('phoneVerifiedAt' in request.resource.data)
        ) ||
        isAdmin() ||
        isPartnerPreRegistrationCreate(userId)
      );
      
      // Atualizar: próprio usuário pode atualizar a si mesmo sem alterar roles/superAdmin;
      // super admin ou convidador do parceiro pendente
      allow update: if request.auth != null && (
        (
          request.auth.uid == userId &&
          (
            !('email' in request.resource.data) ||
            request.resource.data.email == resource.data.email ||
            (
              request.auth.token.email is string &&
              request.resource.data.email == request.auth.token.email
            )
          ) &&
          !('role' in request.resource.data) &&
          (
            !('roles' in request.resource.data) ||
            (
              'roles' in resource.data &&
              request.resource.data.roles == resource.data.roles
            )
          ) &&
          (
            !('superAdmin' in request.resource.data) ||
            request.resource.data.superAdmin == resource.data.superAdmin
          ) &&
          // Reputação do Bora Jogar é derivada por Cloud Function — o dono
          // não pode criá-la nem alterá-la (anti-spoof).
          (
            !('reputation' in request.resource.data) ||
            (
              'reputation' in resource.data &&
              request.resource.data.reputation == resource.data.reputation
            )
          ) &&
          // Elo (sand rank) e cosméticos equipados são derivados por Cloud
          // Function — o dono não pode criá-los nem alterá-los (anti-spoof).
          (
            !('sandRank' in request.resource.data) ||
            (
              'sandRank' in resource.data &&
              request.resource.data.sandRank == resource.data.sandRank
            )
          ) &&
          (
            !('sandRankCosmetics' in request.resource.data) ||
            (
              'sandRankCosmetics' in resource.data &&
              request.resource.data.sandRankCosmetics == resource.data.sandRankCosmetics
            )
          ) &&
          // Vínculo de indicação é derivado por Cloud Function
          // (`registerReferral`) — o dono não pode criá-lo nem alterá-lo
          // diretamente (idempotência/anti-auto-indicação só valem no callable).
          (
            !('referredBy' in request.resource.data) ||
            (
              'referredBy' in resource.data &&
              request.resource.data.referredBy == resource.data.referredBy
            )
          ) &&
          // Telefone verificado é derivado por Cloud Function
          // (`confirmPhoneVerification`, a partir do UserRecord do Firebase
          // Auth) — o dono não pode criá-lo nem alterá-lo diretamente
          // (anti-fraude: impede auto-declarar telefone verificado sem SMS).
          (
            !('phoneNumber' in request.resource.data) ||
            (
              'phoneNumber' in resource.data &&
              request.resource.data.phoneNumber == resource.data.phoneNumber
            )
          ) &&
          (
            !('phoneVerified' in request.resource.data) ||
            (
              'phoneVerified' in resource.data &&
              request.resource.data.phoneVerified == resource.data.phoneVerified
            )
          ) &&
          (
            !('phoneVerifiedAt' in request.resource.data) ||
            (
              'phoneVerifiedAt' in resource.data &&
              request.resource.data.phoneVerifiedAt == resource.data.phoneVerifiedAt
            )
          ) &&
          athleteLevelsNotDowngraded()
        ) ||
        isSuperAdmin() ||
        isPartnerPreRegistrationUpdateByInviter(userId)
      );
      
      // Deletar: apenas super admin pode deletar usuários (e apenas outros, não a si mesmo)
      allow delete: if request.auth != null && request.auth.uid != userId && isSuperAdmin();
    }

    // Regras para notificações do usuário
    match /users/{userId}/tokens/{tokenId} {
      allow read, create, update, delete: if request.auth != null && (
        request.auth.uid == userId ||
        isAdmin() ||
        isSuperAdmin()
      );
    }

    // Assinaturas Web Push (fallback iOS/Safari PWA)
    match /users/{userId}/webPushSubscriptions/{subscriptionId} {
      allow read, create, update, delete: if request.auth != null && (
        request.auth.uid == userId ||
        isAdmin() ||
        isSuperAdmin()
      );
    }

    match /users/{userId}/notifications/{notificationId} {
      // Usuários podem ler apenas suas próprias notificações
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Usuários podem atualizar apenas suas próprias notificações (marcar como lida)
      allow update: if request.auth != null && request.auth.uid == userId;
      
      // Apenas o sistema (via Cloud Functions) pode criar notificações
      // Usuários não podem criar suas próprias notificações
      allow create: if false;
    }

    match /users/{userId}/favorites/{arenaId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/followers/{followerId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.auth.uid == followerId &&
        request.auth.uid != userId;
      allow delete: if request.auth != null && request.auth.uid == followerId;
    }

    match /users/{userId}/following/{followingId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        request.auth.uid == followingId
      );
      allow create, delete: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/followingTeams/{teamId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.data.teamId == teamId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Índice de torneios em que o atleta atua como staff (espelho de tournaments/{id}/staff/{userId})
    match /users/{userId}/tournamentStaff/{tournamentId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update, delete: if request.auth != null && isTournamentOwner(tournamentId);
    }

    // Espelho de `arenas/{arenaId}/staff/{uid}` — é por ele que o portal
    // descobre de quais arenas o usuário é equipe (a query por managerUserId
    // nunca o traria). Mantido pela Cloud Function de sync.
    match /users/{userId}/arenaStaff/{arenaId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    match /users/{userId}/slotVacancyAlerts/{alertId} {
      allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/slotVacancyNotifyLocks/{lockId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Gamificacao do atleta — somente Cloud Functions
    match /users/{userId}/gamification/{docId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    match /users/{userId}/gamification_badges/{badgeId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    match /users/{userId}/gamification_daily_missions/{dayKey} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    match /users/{userId}/gamification_events/{eventId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Recompensas da trilha de elos — concedidas só por Cloud Function.
    // Única escrita permitida ao dono: marcar a celebração como vista.
    match /users/{userId}/gamification_rewards/{rewardId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenAt']);
      allow create, delete: if false;
    }

    // Vouchers de parceiros por elo (resgate em fase futura) — admin only.
    match /rankPartnerVouchers/{voucherId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /arena_reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.arenaId is string &&
        request.resource.data.bookingId is string &&
        request.resource.data.rating is int &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5 &&
        (
          !('comment' in request.resource.data) ||
          request.resource.data.comment == null ||
          request.resource.data.comment is string
        ) &&
        (
          !('likesCount' in request.resource.data) ||
          request.resource.data.likesCount == 0
        ) &&
        (
          !('reported' in request.resource.data) ||
          request.resource.data.reported == false
        );
      allow update: if request.auth != null && (
        // atleta autor pode editar sua própria avaliação sem tocar em `reply`
        (
          resource.data.userId == request.auth.uid &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.arenaId == resource.data.arenaId &&
          request.resource.data.bookingId == resource.data.bookingId &&
          request.resource.data.reply == resource.data.reply &&
          request.resource.data.likesCount == resource.data.likesCount &&
          request.resource.data.reported == resource.data.reported
        ) ||
        // gestor da arena pode criar/editar apenas a resposta oficial
        (
          arenaCanWrite(resource.data.arenaId, 'comunidade') &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.arenaId == resource.data.arenaId &&
          request.resource.data.bookingId == resource.data.bookingId &&
          request.resource.data.rating == resource.data.rating &&
          request.resource.data.comment == resource.data.comment &&
          request.resource.data.reply is map &&
          request.resource.data.reply.message is string &&
          request.resource.data.reply.message.size() >= 5 &&
          request.resource.data.reply.message.size() <= 300 &&
          (
            !('repliedBy' in request.resource.data.reply) ||
            request.resource.data.reply.repliedBy == request.auth.uid ||
            request.resource.data.reply.repliedBy == resource.data.arenaId
          )
        ) ||
        // qualquer usuário autenticado pode apenas sincronizar likesCount
        // junto com sua subcoleção likes/{uid} (transação like/unlike)
        (
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.arenaId == resource.data.arenaId &&
          request.resource.data.bookingId == resource.data.bookingId &&
          request.resource.data.rating == resource.data.rating &&
          request.resource.data.comment == resource.data.comment &&
          request.resource.data.reply == resource.data.reply &&
          request.resource.data.reported == resource.data.reported &&
          (
            (
              request.resource.data.likesCount == resource.data.likesCount + 1 &&
              !exists(/databases/$(database)/documents/arena_reviews/$(reviewId)/likes/$(request.auth.uid)) &&
              existsAfter(/databases/$(database)/documents/arena_reviews/$(reviewId)/likes/$(request.auth.uid))
            ) ||
            (
              request.resource.data.likesCount == resource.data.likesCount - 1 &&
              resource.data.likesCount > 0 &&
              exists(/databases/$(database)/documents/arena_reviews/$(reviewId)/likes/$(request.auth.uid)) &&
              !existsAfter(/databases/$(database)/documents/arena_reviews/$(reviewId)/likes/$(request.auth.uid))
            )
          )
        )
      );
      allow delete: if request.auth != null &&
        resource.data.userId == request.auth.uid;
    }
    match /arena_reviews/{reviewId}/likes/{userId} {
      allow read: if true;
      allow create, delete: if request.auth != null && request.auth.uid == userId;
      allow update: if false;
    }
    match /arena_reviews/{reviewId}/reports/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        isAdmin() ||
        isSuperAdmin()
      );
      allow create, update: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.data.reason is string &&
        request.resource.data.reason.size() >= 5 &&
        request.resource.data.reason.size() <= 280;
      allow delete: if false;
    }
    match /arena_reputation/{arenaId} {
      allow read: if true;
      allow write: if false;
    }

    // O perfil do atleta é armazenado diretamente em users/{userId}
    // As regras acima já cobrem isso - usuários podem ler/escrever seus próprios dados
    //
    // Perfil do atleta v1 no app Flutter: athletes/{athleteId}
    match /athletes/{athleteId} {
      // Leitura: próprio atleta ou admin
      allow read: if request.auth != null && (
        request.auth.uid == athleteId ||
        isAdmin() ||
        isSuperAdmin()
      );

      // Escrita: próprio atleta ou admin
      allow write: if request.auth != null && (
        request.auth.uid == athleteId ||
        isAdmin() ||
        isSuperAdmin()
      );
    }

    // Regras para perfil do administrador: /artifacts/{appId}/users/{userId}/profile/data
    match /artifacts/{appId}/users/{userId}/profile/{profileId} {
      // Usuários podem ler apenas seu próprio perfil
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Usuários podem criar/atualizar apenas seu próprio perfil
      allow create, update: if request.auth != null && request.auth.uid == userId;
      
      // Admins podem ler perfis de qualquer usuário
      allow read: if request.auth != null && isAdmin();
    }

    // Regras para torneios
    match /tournaments/{tournamentId} {
      // Leitura pública: qualquer pessoa (autenticada ou não) pode ler torneios
      // Isso permite que a tela pública funcione sem login
      allow read: if true;
      
      // Criar: admin da plataforma ou gestor de torneios
      allow create: if request.auth != null && (
        isAdmin() ||
        isSuperAdmin() ||
        organizerCanCreateTournament()
      );
      
      // Atualizar/deletar: gestor do torneio, admin da plataforma ou gestor de torneios
      allow update, delete: if request.auth != null && (
        isAdmin() ||
        isSuperAdmin() ||
        (isTournamentOrganizer() && organizerCanUpdateOwnTournament()) ||
        resource.data.managerId == request.auth.uid ||
        isTournamentStaff(tournamentId, ['manager'])
      );

      match /staff/{staffUserId} {
        allow read: if request.auth != null && (
          canManageTournament(tournamentId) ||
          request.auth.uid == staffUserId
        );
        // Somente o dono do torneio gerencia a equipe; dono não pode ser staff de si mesmo.
        allow create, update: if request.auth != null &&
          isTournamentOwner(tournamentId) &&
          staffUserId != request.auth.uid &&
          request.resource.data.role in ['manager', 'scorer'] &&
          request.resource.data.status == 'active';
        allow delete: if request.auth != null && isTournamentOwner(tournamentId);
      }

      match /categoryCommunications/{commId} {
        // Histórico de sendCategoryCommunication — só quem gerencia o
        // torneio lê; escrita só via Admin SDK (Cloud Function).
        allow read: if canManageTournament(tournamentId);
        allow write: if false;
      }
    }

    // Regras para a coleção de equipes (equipes base - apenas dupla de atletas)
    // Caminho: /artifacts/{appId}/public/data/teams
    match /artifacts/{appId}/public/data/teams/{teamId} {
      allow read: if true;
      
      // Criar: apenas via Cloud Functions (convite aceito).
      allow create: if false;
      
      // Atualizar: jogadores da equipe (sem trocar player IDs) ou super admin
      allow update: if request.auth != null && (
        (
          (resource.data.player1Id == request.auth.uid || resource.data.player2Id == request.auth.uid) &&
          teamPlayerIdsUnchanged()
        ) ||
        isSuperAdmin()
      );
      
      // Deletar: apenas super admin pode deletar equipes base
      allow delete: if request.auth != null && isSuperAdmin();
    }

    // Regras para a coleção de inscrições de equipes em torneios
    // Caminho: /artifacts/{appId}/public/data/inscriptions
    // IMPORTANTE: Esta regra deve vir antes da regra padrão para ter prioridade
    // Inscrições: par único por categoria (mesmos integrantes) é enforced em
    // acceptTournamentPartnerInvite (Cloud Functions), não nas rules.
    match /artifacts/{appId}/public/data/inscriptions/{registrationId} {
      // Leitura: documento individual (chaves); list exige login (evita scrape em massa).
      allow get: if true;
      allow list: if request.auth != null;
      
      // Criar inscrição: apenas admin (fluxo atleta via Cloud Functions).
      allow create: if request.auth != null && isAdmin() &&
        inscriptionCreatePaymentSafe() &&
        inscriptionParticipantUidsMatchTeam(appId, request.resource.data.teamId);
      
      // Atualizar inscrição: jogador da dupla (sem campos sensíveis) ou admin
      allow update: if request.auth != null && (
        (
          (exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/teams/$(resource.data.teamId)) &&
           (get(/databases/$(database)/documents/artifacts/$(appId)/public/data/teams/$(resource.data.teamId)).data.player1Id == request.auth.uid ||
            get(/databases/$(database)/documents/artifacts/$(appId)/public/data/teams/$(resource.data.teamId)).data.player2Id == request.auth.uid)) &&
          inscriptionPaymentFieldsUnchanged() &&
          inscriptionEnrollmentFieldsUnchanged() &&
          inscriptionParticipantUidsImmutable() &&
          inscriptionCoreFieldsImmutable()
        ) ||
        isAdmin()
      );
      
      // Deletar inscrição: atleta/gestor só se não paga; admin sempre
      allow delete: if request.auth != null && (
        isAdmin() ||
        (
          resource.data.isPaid != true &&
          (
            (exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/teams/$(resource.data.teamId)) &&
             (get(/databases/$(database)/documents/artifacts/$(appId)/public/data/teams/$(resource.data.teamId)).data.player1Id == request.auth.uid ||
              get(/databases/$(database)/documents/artifacts/$(appId)/public/data/teams/$(resource.data.teamId)).data.player2Id == request.auth.uid)) ||
            canManageTournament(resource.data.tournamentId)
          )
        )
      );
    }

    // Regras para a coleção de partidas (matches)
    // Caminho: /artifacts/{appId}/public/data/matches
    match /artifacts/{appId}/public/data/matches/{matchId} {
      // Leitura pública: qualquer pessoa (autenticada ou não) pode ler partidas
      // Isso permite que a tela pública visualize chaves e resultados
      allow read: if true;
      
      // Criar partida: apenas admins podem criar
      allow create: if request.auth != null && isAdmin();
      
      // Atualizar partida: admin ou ACL por torneio (owner/staff manager/scorer).
      allow update: if request.auth != null && (
        isAdmin() ||
        isSuperAdmin() ||
        (
          canManageTournament(resource.data.tournamentId) &&
          request.resource.data.tournamentId == resource.data.tournamentId &&
          managerCanOnlyEditMatchFields()
        ) ||
        (
          canScoreTournament(resource.data.tournamentId) &&
          request.resource.data.tournamentId == resource.data.tournamentId &&
          scorerCanOnlyEditScoreFields()
        )
      );
      
      // Deletar partida: apenas admins podem deletar
      allow delete: if request.auth != null && isAdmin();

      // Timeline append-only de lançamento (replay / analytics).
      match /pointEvents/{eventId} {
        allow read: if true;
        allow create: if canWriteMatchPointEvents(appId, matchId) && isValidPointEventCreate(appId, matchId);
        allow update, delete: if false;
      }

      // Audit log operacional (I4) — append-only.
      // Leitura restrita à equipe do torneio: metadados operacionais (byUid/byRole)
      // não devem ser públicos. Nenhum cliente consome este log (somente escrita).
      match /auditLog/{eventId} {
        allow read: if request.auth != null && matchDoc(appId, matchId).data != null && (
          isAdmin() ||
          isSuperAdmin() ||
          canManageTournament(matchDoc(appId, matchId).data.tournamentId) ||
          canScoreTournament(matchDoc(appId, matchId).data.tournamentId)
        );
        allow create: if request.auth != null && matchDoc(appId, matchId).data != null && (
          isAdmin() ||
          isSuperAdmin() ||
          canManageTournament(matchDoc(appId, matchId).data.tournamentId) ||
          canScoreTournament(matchDoc(appId, matchId).data.tournamentId)
        );
        allow update, delete: if false;
      }
    }
    
    // Regras para mensagens de contato (criação apenas via Cloud Function após validar captcha)
    match /contactMessages/{messageId} {
      // Criação apenas pelo backend (submitContactMessageSecure); cliente não pode criar direto
      allow create: if false;
      
      // Apenas admins podem ler mensagens de contato
      allow read: if request.auth != null && isAdmin();
      
      // Apenas admins podem atualizar (marcar como lida, etc.)
      allow update: if request.auth != null && isAdmin();
      
      // Apenas admins podem deletar
      allow delete: if request.auth != null && isAdmin();
    }

    // Regras para perfis PRO de atletas
    match /athlete_profiles/{athleteId} {
      // Leitura pública quando o perfil estiver publicado.
      // O próprio atleta e admins também podem ler sempre.
      allow read: if
        (resource != null && resource.data.publicProfileEnabled == true) ||
        (request.auth != null && (
          request.auth.uid == athleteId ||
          isAdmin()
        ));
      
      // Escrita: apenas próprio atleta ou admin
      allow write: if request.auth != null && (
        request.auth.uid == athleteId ||
        isAdmin()
      );
    }

    // Regras para badges (somente leitura para todos autenticados)
    match /badges/{badgeId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }

    // Resultados por categoria (posição final e pontos) - ranking
    // Caminho: /artifacts/{appId}/public/data/tournamentCategoryResults
    match /artifacts/{appId}/public/data/tournamentCategoryResults/{resultId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && isAdmin();
    }

    // Ranking de equipes (agregado) - leitura pública para página de ranking
    // Caminho: /artifacts/{appId}/public/data/teamRankings
    // Para aplicar: firebase deploy --only firestore:rules
    match /artifacts/{appId}/public/data/teamRankings/{teamId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && isAdmin();
    }

    // Ranking de atletas (agregado) - leitura pública para página de ranking
    // Caminho: /artifacts/{appId}/public/data/athleteRankings
    match /artifacts/{appId}/public/data/athleteRankings/{athleteId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && isAdmin();
    }

    // ── Engine de rating (Glicko-2) e escada de níveis ───────────────────
    // Config da escada por esporte (bandas, flags de rollout). Escrita só
    // pelo backoffice/admin; a engine lê via Admin SDK.
    match /ratingLadders/{sportCode} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }

    // Estado derivado de rating por atleta+esporte. Leitura pública (perfil/
    // zone card); escrita exclusiva da engine (Admin SDK bypassa rules).
    match /artifacts/{appId}/public/data/athleteRatings/{ratingId} {
      allow read: if true;
      allow write: if request.auth != null && isAdmin();
    }

    // Ledger append-only de eventos de rating (auditoria/replay). Escrita
    // exclusiva da engine.
    match /artifacts/{appId}/public/data/ratingEvents/{eventId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }

    // Auditoria de mudanças de nível (promoção/rebaixamento/self-upgrade/
    // migração). O atleta lê o próprio histórico; escrita só pela engine.
    match /users/{userId}/levelHistory/{entryId} {
      allow read: if request.auth != null &&
        (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && isAdmin();
    }

    // Ranking agregado por liga/categoria (equipes) - leitura pública
    match /artifacts/{appId}/public/data/leagueTeamRankings/{entryId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && isAdmin();
    }

    // Ranking agregado por liga/categoria (atletas) - leitura pública
    match /artifacts/{appId}/public/data/leagueAthleteRankings/{entryId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && isAdmin();
    }

    // Ligas (metadados e gestão de temporada)
    match /leagues/{leagueId} {
      allow read: if true;
      allow create: if request.auth != null && (
        isAdmin() ||
        (
          request.resource.data.managerId == request.auth.uid &&
          request.resource.data.name is string &&
          request.resource.data.name.size() > 0 &&
          isValidLeagueListingStatus(request.resource.data.listingStatus) &&
          request.resource.data.listingStatus in ['draft', 'open']
        )
      );
      allow update: if request.auth != null && (
        isAdmin() ||
        organizerCanUpdateOwnLeague()
      );
      allow delete: if request.auth != null && (
        isAdmin() ||
        resource.data.managerId == request.auth.uid
      );
    }

    // Avaliações de categoria (feedback dos atletas)
    // Caminho: /artifacts/{appId}/public/data/category_feedbacks
    match /artifacts/{appId}/public/data/category_feedbacks/{feedbackId} {
      // Leitura: documento público (isPrivate == false) qualquer um; documento privado só o autor ou o gestor do torneio
      allow read: if resource == null || (
        resource.data.isPrivate == false ||
        (request.auth != null && request.auth.uid == resource.data.userId) ||
        (request.auth != null && isAdmin() && exists(/databases/$(database)/documents/tournaments/$(resource.data.tournamentId)) && get(/databases/$(database)/documents/tournaments/$(resource.data.tournamentId)).data.managerId == request.auth.uid)
      );
      // Criar: apenas usuário autenticado como autor (userId)
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      // Atualizar: apenas o autor do feedback
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // Depoimentos (marketing) - leitura pública; escrita apenas super admin
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && isSuperAdmin();
    }

    // Patrocinadores da plataforma - leitura pública; escrita apenas super admin
    match /platformSponsors/{sponsorId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && isSuperAdmin();
    }

    // Funnel de instalação PWA + push por usuário
    match /pwaInstallations/{eventId} {
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        isAdmin() ||
        isSuperAdmin()
      );
      allow update, delete: if false;
    }
    
    // NexaGO — visão operacional (documentos agregados para o backoffice; manter status no backend)
    match /torneios/{torneioId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && (
        isAdmin() ||
        isSuperAdmin() ||
        organizerCanCreateOperationalTorneio()
      );
      allow update: if request.auth != null && (
        isAdmin() ||
        isSuperAdmin() ||
        organizerCanUpdateOwnOperationalTorneio()
      );
      allow delete: if request.auth != null && (
        isAdmin() ||
        isSuperAdmin() ||
        organizerCanDeleteOwnOperationalTorneio()
      );
    }

    // Convites de parceiro para inscrição em torneio (escrita via Cloud Functions)
    match /tournamentRegistrationInvites/{inviteId} {
      allow read: if request.auth != null && (
        resource.data.inviterUid == request.auth.uid ||
        resource.data.inviteeUid == request.auth.uid
      );
      allow list: if request.auth != null;
      allow create, update, delete: if false;
    }

    // Bora Jogar — convites/jogos avulsos entre atletas (N participantes).
    // Escrita exclusiva via Cloud Functions; leitura de quem já é
    // organizador/confirmado (participantUids) OU tem vaga pendente
    // (pendingSlotUids) — sem o segundo disjunto, quem ainda não respondeu
    // o próprio convite não conseguiria nem ler pra decidir.
    match /friendlyMatches/{matchId} {
      allow read: if request.auth != null && (
        resource.data.organizerUid == request.auth.uid ||
        request.auth.uid in resource.data.participantUids ||
        request.auth.uid in resource.data.pendingSlotUids
      );
      allow create, update, delete: if false;

      // Avaliações double-blind: notas ficam ilegíveis até o reveal (só a
      // Cloud Function lê/escreve via Admin SDK). Sem este bloco o catch-all
      // do fim do arquivo daria read a qualquer autenticado. Chave composta
      // reviewerUid_revieweeUid (cada avaliador avalia N-1 pessoas).
      match /privateReviews/{reviewKey} {
        allow read, write: if false;
      }
    }

    // Versão mínima do app (gate de atualização obrigatória). Leitura pública:
    // o bloqueio precisa valer também na tela de login, antes de haver auth.
    // Não guarda nada sensível — só build number, link da loja e textos.
    match /appConfig/appVersion {
      allow read: if true;
      allow write: if false;
    }

    // Config de features lida pelo app (ex.: appConfig/friendlyMatch).
    match /appConfig/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Reputação do Bora Jogar: ledger auditável (só o dono lê) e summary
    // derivado (público, como o espelho em public_profiles). Escrita só CF.
    match /users/{userId}/reputationEvents/{eventId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }
    match /users/{userId}/reputation/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Lista de espera do site público (captura de e-mail pré-lançamento).
    // Criação pública e validada (sem auth); leitura/edição/remoção bloqueadas.
    match /waitlist/{docId} {
      allow read, update, delete: if false;
      allow create: if
        request.resource.data.keys().hasOnly(['email', 'source', 'createdAt']) &&
        request.resource.data.email is string &&
        request.resource.data.email.size() >= 5 &&
        request.resource.data.email.size() <= 320 &&
        request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+[.][^@\\s]+$') &&
        request.resource.data.source is string &&
        request.resource.data.source.size() <= 64 &&
        request.resource.data.createdAt is timestamp;
    }

    // Leads B2B do site (organizadores e arenas). Criação pública e validada
    // (sem auth, via Route Handler); leitura/edição/remoção bloqueadas.
    match /leads/{docId} {
      allow read, update, delete: if false;
      allow create: if
        request.resource.data.keys().hasOnly(
          ['name', 'email', 'phone', 'org', 'message', 'persona', 'source', 'createdAt']
        ) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() >= 2 &&
        request.resource.data.name.size() <= 120 &&
        request.resource.data.email is string &&
        request.resource.data.email.size() >= 5 &&
        request.resource.data.email.size() <= 320 &&
        request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+[.][^@\\s]+$') &&
        request.resource.data.phone is string &&
        request.resource.data.phone.size() <= 40 &&
        request.resource.data.org is string &&
        request.resource.data.org.size() <= 160 &&
        request.resource.data.message is string &&
        request.resource.data.message.size() <= 1000 &&
        request.resource.data.persona in ['organizador', 'arena', 'geral'] &&
        request.resource.data.source is string &&
        request.resource.data.source.size() <= 64 &&
        request.resource.data.createdAt is timestamp;
    }

    // ── Portal do Treinador (coach) ─────────────────────────────
    // Dados do treinador são propriedade exclusiva do próprio treinador — é
    // ownership (uid do path == uid autenticado), não precisa de claim de
    // papel pra ler/escrever. A claim `coach` só importa pro guard de rota
    // no frontend. Operações que cruzam usuários (convite, convocação) têm
    // client write: false — só Cloud Functions (Admin SDK) escrevem.
    match /coaches/{coachUid} {
      allow read, write: if request.auth != null && request.auth.uid == coachUid;

      match /squads/{squadId} {
        allow read, write: if request.auth != null && request.auth.uid == coachUid;
      }
      match /athletes/{athleteUid} {
        allow read, write: if request.auth != null && request.auth.uid == coachUid;
      }
      match /trainings/{trainingId} {
        allow read, write: if request.auth != null && request.auth.uid == coachUid;
      }
      // Diferente das outras subcoleções: um atleta CONVOCADO também precisa
      // ler este doc (pra ver os detalhes antes de responder em /convocacao).
      // Escrita é sempre false — criação e resposta passam por Cloud Function
      // (Task 12): a criação faz Promise.all de notificações e a resposta é
      // de um usuário que não é dono do doc, então nenhum dos dois cabe em
      // client-write direto.
      match /callUps/{callUpId} {
        allow read: if request.auth != null && (
          request.auth.uid == coachUid ||
          request.auth.uid in resource.data.recipients
        );
        allow write: if false;
      }
      match /evaluations/{evalId} {
        allow read, write: if request.auth != null && request.auth.uid == coachUid;
      }
    }

    // Convite de vínculo treinador→atleta. Leitura só de quem participa;
    // escrita exclusiva via Cloud Function (aceite precisa validar estado e
    // criar coaches/{coachUid}/athletes/{athleteUid} numa transação).
    match /coachAthleteInvites/{inviteId} {
      allow read: if request.auth != null && (
        resource.data.coachUid == request.auth.uid ||
        resource.data.athleteUid == request.auth.uid
      );
      allow list: if false;
      allow create, update, delete: if false;
    }

    // Palpites da torcida no chaveamento (feature de engajamento/gamificação,
    // sem dinheiro real) — tournamentPredictions/{tournamentId}/entries/{userId}.
    // Leitura pública: é torcida, a graça é um leaderboard público de quem
    // acerta mais palpites. Escrita exclusiva via Cloud Function
    // (`submitBracketPrediction` valida uid/torneio/status da partida antes
    // de gravar; a pontuação é creditada pelo trigger de conclusão de
    // partida) — nunca client-write direto.
    match /tournamentPredictions/{tournamentId}/entries/{userId} {
      allow read: if true;
      allow write: if false;
    }

    // Página pública de links (link-in-bio) de arena/organizador.
    // Leitura pública: o site renderiza `/a/{slug}` e `/o/{slug}` sem login.
    // Escrita do PERFIL só via Cloud Function (`saveLinkPageProfile`): trocar o
    // endereço precisa mover `linkPageSlugs/{slug}` na mesma transação, senão
    // dois donos reivindicam o mesmo slug. Contadores (views/clicks e os mapas
    // diários) também são exclusivos da function `trackLinkPageEvent` — o
    // visitante é anônimo e não pode receber escrita direta no documento.
    function isLinkPageOwner(pageData) {
      return request.auth != null && (
        isSuperAdmin() || (
          pageData.ownerType == 'organizer'
            ? pageData.ownerId == request.auth.uid
            : arenaCanWrite(pageData.ownerId, 'site')
        )
      );
    }
    match /linkPages/{pageId} {
      allow read: if true;
      allow write: if false;

      // Os links em si o dono escreve direto — não há nada atômico a garantir.
      // Só os contadores ficam de fora (mantidos por `trackLinkPageEvent`).
      match /links/{linkId} {
        allow read: if true;
        allow create: if isLinkPageOwner(get(/databases/$(database)/documents/linkPages/$(pageId)).data) &&
          request.resource.data.get('clicks', 0) == 0 &&
          request.resource.data.get('dailyClicks', {}).size() == 0;
        allow update: if isLinkPageOwner(get(/databases/$(database)/documents/linkPages/$(pageId)).data) &&
          request.resource.data.get('clicks', 0) == resource.data.get('clicks', 0) &&
          request.resource.data.get('dailyClicks', {}) == resource.data.get('dailyClicks', {});
        allow delete: if isLinkPageOwner(get(/databases/$(database)/documents/linkPages/$(pageId)).data);
      }
    }
    // Registro de unicidade de endereço: slug -> pageId. Leitura pública porque
    // é o índice que resolve a URL; escrita só pela function.
    match /linkPageSlugs/{slug} {
      allow read: if true;
      allow write: if false;
    }

    // Mini-site público da arena (landing /s/{slug} no site). Produto
    // SEPARADO do link-in-bio acima. O gestor edita o rascunho direto
    // (`arenaSites/{arenaId}`), mas o público só lê o espelho
    // `arenaSitesPublic/{slug}`, escrito exclusivamente pela function
    // `publishArenaSite` — é lá que conteúdo, tema e URLs são validados.
    // Status/slug no rascunho são informativos: espelho é a única fonte pública.
    function isArenaSiteManager(arenaId) {
      return request.auth != null && (
        isSuperAdmin() ||
        arenaCanWrite(arenaId, 'site')
      );
    }
    match /arenaSites/{arenaId} {
      allow read, write: if isArenaSiteManager(arenaId);
    }
    match /arenaSitesPublic/{slug} {
      allow read: if true;
      allow write: if false;
    }
    // Unicidade de endereço do mini-site: slug -> arenaId. Independente do
    // linkPageSlugs; escrita só pela function.
    match /arenaSiteSlugs/{slug} {
      allow read: if true;
      allow write: if false;
    }

    // NEGAÇÃO padrão para caminhos não mapeados.
    // ATENÇÃO à semântica do Firestore: quando vários `match` cobrem o mesmo
    // caminho, os `allow` fazem OR — um catch-all com `allow read` CONCEDE
    // leitura a tudo e ANULA as restrições específicas acima (foi o que
    // acontecia aqui: PII de users, convites e avaliações double-blind
    // ficavam legíveis por qualquer autenticado). Um catch-all só é seguro
    // negando tudo; coleção nova precisa de regra explícita própria.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
