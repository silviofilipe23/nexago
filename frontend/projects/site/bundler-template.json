-cf80d710da0e\") format('woff2');\n}\n\n.material-symbols-rounded {\n  font-family: 'Material Symbols Rounded';\n  font-weight: normal;\n  font-style: normal;\n  font-size: 24px;\n  line-height: 1;\n  letter-spacing: normal;\n  text-transform: none;\n  display: inline-block;\n  white-space: nowrap;\n  word-wrap: normal;\n  direction: ltr;\n  -webkit-font-feature-settings: 'liga';\n  -webkit-font-smoothing: antialiased;\n}\n\n\n:root {\n  --bg:        #050505;\n  --bg-2:      #0A0A0B;\n  --s0:        #0B0B0C;\n  --s1:        #131316;\n  --s2:        #1B1B1F;\n  --line:      rgba(255,255,255,0.08);\n  --line-2:    rgba(255,255,255,0.14);\n\n  --orange:    #FF6A1A;\n  --orange-4:  #FF8A4A;\n  --orange-6:  #E5560E;\n  --tint:      rgba(255,106,26,0.12);\n\n  --text:      #F4F4F5;\n  --mute:      rgba(244,244,245,0.62);\n  --dim:       rgba(244,244,245,0.40);\n  --on-orange: #0A0A0A;\n\n  --win:       #2BD17E;\n  --live:      #FF3B30;\n  --pend:      #F4C543;\n\n  --display:   'Sora', system-ui, sans-serif;\n  --ui:        'Inter', system-ui, sans-serif;\n  --mono:      'JetBrains Mono', ui-monospace, monospace;\n\n  --maxw:      1200px;\n  --ease:      cubic-bezier(0.22, 1, 0.36, 1);\n}\n\n* { box-sizing: border-box; -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility; }\nhtml { scroll-behavior: smooth; }\nbody {\n  margin: 0; padding: 0;\n  background: var(--bg); color: var(--text);\n  font-family: var(--ui);\n  line-height: 1.5;\n  overflow-x: hidden;\n}\na { color: inherit; text-decoration: none; }\nimg { display: block; max-width: 100%; }\nbutton { font-family: inherit; cursor: pointer; }\n\n.material-symbols-rounded {\n  font-family: 'Material Symbols Rounded' !important;\n  font-weight: normal; font-style: normal;\n  font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;\n  font-size: inherit; line-height: 1; vertical-align: middle; user-select: none;\n  white-space: nowrap; word-wrap: normal; direction: ltr;\n}\n\n/* ── shared bits ─────────────────────────────────────────── */\n.wrap { max-width: var(--maxw); margin: 0 auto; padding: 0 32px; }\n.eyebrow {\n  display: inline-flex; align-items: center; gap: 8px;\n  font-family: var(--mono); font-size: 11px; font-weight: 700;\n  letter-spacing: 0.18em; text-transform: uppercase; color: var(--orange);\n}\n.eyebrow .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--orange);\n  box-shadow: 0 0 10px var(--orange); }\n.eyebrow.mute { color: var(--dim); }\n.eyebrow.mute .dot { background: var(--dim); box-shadow: none; }\n\nh1, h2, h3 { font-family: var(--display); font-weight: 800; letter-spacing: -0.025em; margin: 0;\n  line-height: 1.04; text-wrap: balance; }\n.section-title { font-size: clamp(30px, 4vw, 46px); }\n.section-lead { color: var(--mute); font-size: clamp(16px, 1.5vw, 18px); max-width: 46ch;\n  margin: 18px auto 0; text-wrap: pretty; }\n\n.section { padding: clamp(72px, 10vw, 130px) 0; position: relative; }\n.section-head { text-align: center; margin-bottom: clamp(40px, 6vw, 68px); }\n.section-head .eyebrow { margin-bottom: 18px; }\n\n/* buttons */\n.btn {\n  display: inline-flex; align-items: center; justify-content: center; gap: 9px;\n  height: 52px; padding: 0 26px; border-radius: 999px; border: none;\n  font-family: var(--display); font-weight: 700; font-size: 15px; letter-spacing: -0.01em;\n  transition: transform .18s var(--ease), box-shadow .18s var(--ease), background .18s var(--ease);\n}\n.btn-primary { background: var(--orange); color: var(--on-orange);\n  box-shadow: 0 0 0 1px rgba(255,106,26,0.4), 0 14px 40px rgba(255,106,26,0.32); }\n.btn-primary:hover { transform: translateY(-2px); box-shadow: 0 0 0 1px rgba(255,106,26,0.6), 0 20px 52px rgba(255,106,26,0.45); }\n.btn-ghost { background: var(--s1); color: var(--text); border: 1px solid var(--line-2); }\n.btn-ghost:hover { background: var(--s2); transform: translateY(-2px); }\n\n/* store buttons */\n.stores { display: flex; gap: 12px; flex-wrap: wrap; }\n.store {\n  display: inline-flex; align-items: center; gap: 12px;\n  height: 58px; padding: 0 22px 0 18px; border-radius: 14px;\n  background: var(--s1); border: 1px solid var(--line-2); color: var(--text);\n  transition: transform .18s var(--ease), border-color .18s var(--ease), background .18s var(--ease);\n}\n.store:hover { transform: translateY(-2px); border-color: rgba(255,106,26,0.5); background: var(--s2); }\n.store .material-symbols-rounded { font-size: 30px; color: var(--text); }\n.store .st-txt { display: flex; flex-direction: column; line-height: 1.1; }\n.store .st-top { font-family: var(--ui); font-size: 10px; color: var(--mute); letter-spacing: 0.04em; }\n.store .st-name { font-family: var(--display); font-weight: 700; font-size: 17px; letter-spacing: -0.01em; }\n\n/* card base */\n.card {\n  background: var(--s0); border: 1px solid var(--line); border-radius: 20px;\n}\n\n/* reveal on scroll */\n.reveal { opacity: 0; transform: translateY(28px); transition: opacity .7s var(--ease), transform .7s var(--ease); }\n.reveal.in { opacity: 1; transform: none; }\n.reveal.d1 { transition-delay: .08s; } .reveal.d2 { transition-delay: .16s; }\n.reveal.d3 { transition-delay: .24s; } .reveal.d4 { transition-delay: .32s; }\n\n@media (prefers-reduced-motion: reduce) {\n  .reveal { opacity: 1; transform: none; transition: none; }\n  html { scroll-behavior: auto; }\n}\n\n/* ═══ NAV ═══════════════════════════════════════════════════ */\n.nav {\n  position: fixed; top: 0; left: 0; right: 0; z-index: 100;\n  display: flex; align-items: center; justify-content: space-between;\n  padding: 16px 32px; transition: background .3s var(--ease), border-color .3s var(--ease), padding .3s var(--ease);\n  border-bottom: 1px solid transparent;\n}\n.nav.scrolled { background: rgba(5,5,5,0.78); backdrop-filter: blur(18px) saturate(1.2);\n  border-bottom-color: var(--line); padding: 12px 32px; }\n.brand { display: flex; align-items: center; gap: 11px; font-family: var(--display);\n  font-weight: 800; font-size: 21px; letter-spacing: -0.03em; }\n.brand .mark {\n  width: 38px; height: 38px; border-radius: 9px; display: grid; place-items: center;\n  background: url(\"ed7cffd4-70a4-4df3-b796-9426395d46e2\") center / contain no-repeat;\n  font-size: 0; color: transparent; box-shadow: none;\n}\n.brand .go { color: var(--orange); }\n.nav-links { display: flex; align-items: center; gap: 6px; }\n.nav-links a { font-size: 14px; font-weight: 500; color: var(--mute); padding: 9px 14px;\n  border-radius: 9px; transition: color .15s, background .15s; }\n.nav-links a:hover { color: var(--text); background: var(--s1); }\n.nav-cta { display: flex; align-items: center; gap: 10px; }\n.nav-cta .btn { height: 44px; padding: 0 20px; font-size: 14px; }\n.nav-toggle { display: none; width: 44px; height: 44px; border-radius: 11px; background: var(--s1);\n  border: 1px solid var(--line-2); color: var(--text); place-items: center; }\n.nav-toggle .material-symbols-rounded { font-size: 24px; }\n\n/* ═══ HERO ══════════════════════════════════════════════════ */\n.hero { position: relative; padding: 150px 0 90px; overflow: hidden; }\n.hero-bg { position: absolute; inset: 0; z-index: 0; pointer-events: none; }\n.glow-a { position: absolute; top: -10%; right: -5%; width: 70vw; height: 70vw; max-width: 900px; max-height: 900px;\n  background: radial-gradient(circle, rgba(255,106,26,0.30) 0%, rgba(229,86,14,0.12) 35%, transparent 65%);\n  filter: blur(20px); }\n.glow-b { position: absolute; bottom: -20%; left: -15%; width: 60vw; height: 60vw; max-width: 760px; max-height: 760px;\n  background: radial-gradient(circle, rgba(255,106,26,0.14) 0%, transparent 62%); filter: blur(30px); }\n.court-lines { position: absolute; inset: 0; opacity: 0.5;\n  background-image:\n    linear-gradient(transparent 0, transparent calc(100% - 1px), rgba(255,255,255,0.025) 100%),\n    linear-gradient(90deg, transparent 0, transparent calc(100% - 1px), rgba(255,255,255,0.025) 100%);\n  background-size: 64px 64px;\n  mask-image: radial-gradient(circle at 60% 40%, #000 0%, transparent 75%); }\n\n.hero-grid { position: relative; z-index: 2; display: grid; grid-template-columns: 1.05fr 0.95fr;\n  gap: 48px; align-items: center; }\n.hero-copy { max-width: 560px; }\n.launch-pill {\n  display: inline-flex; align-items: center; gap: 10px; padding: 8px 8px 8px 14px;\n  border-radius: 999px; background: var(--tint); border: 1px solid rgba(255,106,26,0.3);\n  font-family: var(--mono); font-size: 11px; font-weight: 700; letter-spacing: 0.1em;\n  text-transform: uppercase; color: var(--orange); margin-bottom: 26px; white-space: nowrap;\n}\n.launch-pill .chip { background: var(--orange); color: var(--on-orange); padding: 3px 9px;\n  border-radius: 999px; font-size: 10px; white-space: nowrap; flex-shrink: 0; }\n.hero h1 { font-size: clamp(42px, 6.2vw, 76px); }\n.hero h1 .accent { color: var(--orange); }\n.hero-sub { color: var(--mute); font-size: clamp(17px, 1.7vw, 20px); margin: 24px 0 32px;\n  max-width: 50ch; text-wrap: pretty; }\n.hero-actions { display: flex; flex-direction: column; gap: 22px; }\n.hero-proof { display: flex; align-items: center; gap: 14px; }\n.avatars { display: flex; }\n.avatars .av { width: 38px; height: 38px; border-radius: 50%; border: 2px solid var(--bg);\n  margin-left: -10px; display: grid; place-items: center; font-family: var(--display);\n  font-weight: 700; font-size: 13px; color: #fff; }\n.avatars .av:first-child { margin-left: 0; }\n.hero-proof-txt { font-size: 13px; color: var(--mute); }\n.hero-proof-txt b { color: var(--text); font-weight: 600; }\n\n/* ── phone mockup ─────────────────────────────────────────── */\n.hero-phone { position: relative; justify-self: center; }\n.phone {\n  position: relative; width: 320px; height: 660px; border-radius: 46px; padding: 11px;\n  background: linear-gradient(160deg, #2a2a2e, #empty 0, #141417 60%); background: #18181c;\n  border: 1px solid rgba(255,255,255,0.1);\n  box-shadow: 0 0 0 1px rgba(0,0,0,0.6), 0 50px 100px rgba(0,0,0,0.7), 0 0 80px rgba(255,106,26,0.18);\n}\n.phone-screen { width: 100%; height: 100%; border-radius: 36px; overflow: hidden;\n  background: var(--bg); position: relative; }\n.phone-notch { position: absolute; top: 14px; left: 50%; transform: translateX(-50%);\n  width: 108px; height: 26px; background: #050505; border-radius: 999px; z-index: 20; }\n\n/* in-app screen */\n.app { position: absolute; inset: 0; font-family: var(--ui); overflow: hidden; }\n.app-head { padding: 50px 16px 10px; display: flex; align-items: center; gap: 9px;\n  background: linear-gradient(180deg, #050505 72%, transparent); position: relative; z-index: 6; }\n.app-ava { width: 38px; height: 38px; border-radius: 12px; flex-shrink: 0;\n  background: linear-gradient(135deg, var(--orange) 0%, #C00 100%); display: grid; place-items: center;\n  font-family: var(--display); font-weight: 800; font-size: 13px; color: var(--on-orange); position: relative; }\n.app-ava .streak { position: absolute; bottom: -4px; right: -4px; padding: 1px 5px; border-radius: 999px;\n  background: #050505; color: var(--orange); border: 1.5px solid var(--orange);\n  font-family: var(--mono); font-weight: 800; font-size: 8px; display: inline-flex; align-items: center; gap: 2px; }\n.app-greet { flex: 1; min-width: 0; }\n.app-greet .g1 { font-family: var(--mono); font-size: 8px; color: rgba(244,244,245,0.55);\n  letter-spacing: 0.14em; text-transform: uppercase; font-weight: 600; }\n.app-greet .g2 { font-family: var(--display); font-weight: 700; font-size: 15px; margin-top: 1px; }\n.app-xp { height: 28px; padding: 0 9px; border-radius: 9px; background: var(--tint);\n  border: 1px solid rgba(255,106,26,0.25); display: inline-flex; align-items: center; gap: 5px; }\n.app-xp .material-symbols-rounded { font-size: 13px; color: var(--orange); }\n.app-xp span { font-family: var(--mono); font-weight: 700; font-size: 10px; color: var(--orange); }\n.app-bell { width: 34px; height: 34px; border-radius: 11px; background: var(--s1);\n  border: 1px solid var(--line); display: grid; place-items: center; position: relative; flex-shrink: 0; }\n.app-bell .material-symbols-rounded { font-size: 16px; color: var(--text); }\n.app-bell .badge { position: absolute; top: 5px; right: 5px; min-width: 13px; height: 13px;\n  border-radius: 999px; background: var(--orange); color: var(--on-orange); border: 2px solid var(--s1);\n  font-family: var(--mono); font-size: 7px; font-weight: 800; display: grid; place-items: center; }\n\n.app-body { padding: 6px 16px; display: flex; flex-direction: column; gap: 14px; }\n/* hero reservation card */\n.app-resv { position: relative; overflow: hidden; border-radius: 20px; padding: 16px;\n  background: linear-gradient(155deg, #FF6A1A 0%, #E5560E 58%, #2A1408 100%); color: var(--on-orange); }\n.app-resv .blob { position: absolute; right: -40px; top: -40px; width: 160px; height: 160px;\n  border-radius: 50%; background: radial-gradient(circle, rgba(255,255,255,0.18), transparent 70%); }\n.app-resv .top { position: relative; display: flex; align-items: center; justify-content: space-between; }\n.app-resv .cd { font-family: var(--mono); font-size: 9px; font-weight: 800; letter-spacing: 0.12em;\n  text-transform: uppercase; color: rgba(10,10,10,0.75); }\n.app-resv .tag { padding: 3px 8px; border-radius: 6px; background: rgba(10,10,10,0.18);\n  font-family: var(--mono); font-size: 8px; font-weight: 800; letter-spacing: 0.08em; }\n.app-resv .ttl { position: relative; font-family: var(--display); font-weight: 800; font-size: 20px;\n  letter-spacing: -0.02em; margin-top: 9px; line-height: 1.08; }\n.app-resv .meta { position: relative; display: flex; align-items: center; gap: 10px; margin-top: 7px;\n  font-size: 12px; color: rgba(10,10,10,0.8); }\n.app-resv .meta .material-symbols-rounded { font-size: 13px; }\n.app-resv .sep { width: 3px; height: 3px; border-radius: 50%; background: rgba(10,10,10,0.4); }\n.app-resv .cta-row { position: relative; display: flex; gap: 7px; margin-top: 14px; }\n.app-resv .b-main { flex: 1; height: 38px; border-radius: 11px; background: #0a0a0a; color: var(--orange);\n  border: none; font-family: var(--display); font-weight: 700; font-size: 12px;\n  display: inline-flex; align-items: center; justify-content: center; gap: 6px; }\n.app-resv .b-main .material-symbols-rounded { font-size: 14px; }\n.app-resv .b-icon { width: 38px; height: 38px; border-radius: 11px; background: rgba(10,10,10,0.2);\n  color: #0a0a0a; border: none; display: grid; place-items: center; }\n.app-resv .b-icon .material-symbols-rounded { font-size: 15px; }\n\n/* quick actions */\n.app-quick { display: grid; grid-template-columns: repeat(4, 1fr); gap: 7px; }\n.app-quick .q { aspect-ratio: 1 / 0.92; border-radius: 13px; background: var(--s0);\n  border: 1px solid rgba(255,255,255,0.06); display: flex; flex-direction: column;\n  align-items: center; justify-content: center; gap: 5px; }\n.app-quick .q.accent { background: var(--tint); border-color: rgba(255,106,26,0.3); }\n.app-quick .q .material-symbols-rounded { font-size: 18px; color: var(--text); }\n.app-quick .q.accent .material-symbols-rounded { color: var(--orange); }\n.app-quick .q span { font-size: 9.5px; font-weight: 600; color: rgba(244,244,245,0.9); }\n.app-quick .q.accent span { color: var(--orange); }\n\n/* mini section label */\n.app-lbl { display: flex; align-items: baseline; justify-content: space-between; }\n.app-lbl b { font-family: var(--display); font-weight: 700; font-size: 13px; }\n.app-lbl .act { font-family: var(--mono); font-size: 8px; font-weight: 700; letter-spacing: 0.1em;\n  text-transform: uppercase; color: var(--orange); }\n\n/* open game card inside phone */\n.app-game { border-radius: 14px; padding: 12px; background: var(--s0); border: 1px solid rgba(255,255,255,0.06);\n  display: flex; align-items: center; gap: 10px; }\n.app-game .ico { width: 38px; height: 38px; border-radius: 11px; background: rgba(43,209,126,0.12);\n  color: var(--win); display: grid; place-items: center; flex-shrink: 0; }\n.app-game .ico .material-symbols-rounded { font-size: 19px; }\n.app-game .gi { flex: 1; min-width: 0; }\n.app-game .gn { font-family: var(--display); font-weight: 700; font-size: 12px; }\n.app-game .gs { font-size: 10px; color: var(--mute); margin-top: 1px; }\n.app-game .gtag { padding: 4px 8px; border-radius: 7px; background: rgba(43,209,126,0.12);\n  color: var(--win); font-family: var(--mono); font-size: 8px; font-weight: 800; letter-spacing: 0.06em; }\n\n/* tab bar */\n.app-tabs { position: absolute; bottom: 0; left: 0; right: 0; height: 64px; z-index: 8;\n  background: linear-gradient(0deg, #050505 78%, transparent); display: flex; align-items: center;\n  justify-content: space-around; padding: 0 10px 14px; }\n.app-tabs .t { display: flex; flex-direction: column; align-items: center; gap: 3px; color: var(--dim); }\n.app-tabs .t.on { color: var(--orange); }\n.app-tabs .t .material-symbols-rounded { font-size: 21px; }\n.app-tabs .t span { font-size: 8px; font-weight: 600; }\n\n/* floating accent cards around phone */\n.float { position: absolute; z-index: 30; border-radius: 16px; padding: 12px 14px;\n  background: rgba(15,15,17,0.82); backdrop-filter: blur(14px); border: 1px solid var(--line-2);\n  box-shadow: 0 20px 50px rgba(0,0,0,0.5); }\n.float-score { top: -26px; left: -56px; }\n.float-streak { bottom: 70px; right: -42px; }\n.float .fl-head { display: flex; align-items: center; gap: 7px; margin-bottom: 8px; }\n.float .live-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--live);\n  box-shadow: 0 0 8px var(--live); }\n.float .fl-lbl { font-family: var(--mono); font-size: 9px; font-weight: 800; letter-spacing: 0.1em;\n  text-transform: uppercase; color: var(--live); }\n.float .fl-lbl.orange { color: var(--orange); }\n.float .live-dot.orange { background: var(--orange); box-shadow: 0 0 8px var(--orange); }\n.float .score { display: flex; align-items: center; gap: 12px; font-family: var(--mono); }\n.float .score .nm { font-size: 11px; color: var(--mute); }\n.float .score .pt { font-family: var(--display); font-weight: 800; font-size: 22px; letter-spacing: -0.02em; }\n.float .score .pt.win { color: var(--orange); }\n.float-streak .st-num { font-family: var(--display); font-weight: 800; font-size: 26px; letter-spacing: -0.02em; }\n.float-streak .st-sub { font-size: 11px; color: var(--mute); margin-top: 2px; }\n.float-streak .flame { color: var(--orange); }\n\n@keyframes floaty { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-9px); } }\n.float-score { animation: floaty 5s var(--ease) infinite; }\n.float-streak { animation: floaty 5.6s var(--ease) infinite .6s; }\n@media (prefers-reduced-motion: reduce) { .float-score, .float-streak { animation: none; } }\n\n/* ═══ STATS STRIP ═══════════════════════════════════════════ */\n.stats { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);\n  background: var(--bg-2); }\n.stats-inner { display: grid; grid-template-columns: repeat(4, 1fr); }\n.stat { padding: 44px 28px; text-align: center; border-right: 1px solid var(--line); }\n.stat:last-child { border-right: none; }\n.stat .num { font-family: var(--display); font-weight: 800; font-size: clamp(34px, 4vw, 52px);\n  letter-spacing: -0.03em; color: var(--text); }\n.stat .num .u { color: var(--orange); }\n.stat .lbl { font-family: var(--mono); font-size: 11px; font-weight: 600; letter-spacing: 0.12em;\n  text-transform: uppercase; color: var(--mute); margin-top: 8px; }\n\n/* ═══ COMO FUNCIONA ═════════════════════════════════════════ */\n.como-tabswrap { display: flex; justify-content: center; margin-bottom: clamp(36px, 5vw, 56px); }\n.como-tabs { display: inline-flex; gap: 6px; padding: 6px; border-radius: 999px;\n  background: var(--s0); border: 1px solid var(--line); }\n.como-tab { display: inline-flex; align-items: center; justify-content: center; gap: 8px;\n  height: 48px; padding: 0 24px; border-radius: 999px; background: transparent; border: none;\n  color: var(--mute); font-family: var(--display); font-weight: 600; font-size: 15px;\n  letter-spacing: -0.01em; transition: color .18s var(--ease), background .18s var(--ease), box-shadow .18s var(--ease); }\n.como-tab .material-symbols-rounded { font-size: 20px; }\n.como-tab:hover { color: var(--text); }\n.como-tab.active { background: var(--orange); color: var(--on-orange);\n  box-shadow: 0 8px 24px rgba(255,106,26,0.3); }\n\n.como-panel { display: none; }\n.como-panel.active { display: block; animation: comoIn .4s var(--ease) both; }\n@keyframes comoIn { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }\n@media (prefers-reduced-motion: reduce) { .como-panel.active { animation: none; } }\n\n.steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }\n.step { position: relative; padding: 28px 24px 26px; }\n.step .n { font-family: var(--mono); font-size: 12px; font-weight: 700; color: var(--orange);\n  letter-spacing: 0.1em; }\n.step .ic { width: 52px; height: 52px; border-radius: 15px; background: var(--tint);\n  border: 1px solid rgba(255,106,26,0.22); display: grid; place-items: center; margin: 18px 0 18px; }\n.step .ic .material-symbols-rounded { font-size: 26px; color: var(--orange); }\n.step h3 { font-size: 19px; margin-bottom: 8px; }\n.step p { color: var(--mute); font-size: 14.5px; margin: 0; text-wrap: pretty; }\n.step .ln { position: absolute; top: 64px; right: -10px; color: var(--dim); }\n\n/* ═══ FUNCIONALIDADES ═══════════════════════════════════════ */\n.features { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }\n.feature { padding: 26px; min-width: 0; transition: border-color .2s var(--ease), transform .2s var(--ease); }\n.feature:hover { border-color: rgba(255,106,26,0.4); transform: translateY(-3px); }\n.feature .ic { width: 48px; height: 48px; border-radius: 13px; background: var(--s1);\n  border: 1px solid var(--line); display: grid; place-items: center; margin-bottom: 18px; }\n.feature .ic .material-symbols-rounded { font-size: 24px; color: var(--orange); }\n.feature h3 { font-size: 18px; margin-bottom: 9px; }\n.feature p { color: var(--mute); font-size: 14px; margin: 0; text-wrap: pretty; }\n.feature .soon { display: inline-block; margin-top: 14px; font-family: var(--mono); font-size: 9px;\n  font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--pend);\n  background: rgba(244,197,67,0.1); padding: 4px 9px; border-radius: 999px; }\n.feature.big { grid-column: 1 / -1; display: flex; gap: 26px; align-items: center; }\n.feature.big .fb-txt { flex: 1; }\n\n/* ═══ TORNEIOS E LIGAS ══════════════════════════════════════ */\n.split { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; }\n.split-copy h2 { font-size: clamp(30px, 3.6vw, 44px); margin-bottom: 18px; }\n.split-copy p { color: var(--mute); font-size: 17px; margin: 0 0 26px; text-wrap: pretty; }\n.checklist { list-style: none; padding: 0; margin: 0 0 30px; display: flex; flex-direction: column; gap: 14px; }\n.checklist li { display: flex; align-items: flex-start; gap: 12px; font-size: 15px; }\n.checklist .ck { width: 24px; height: 24px; border-radius: 8px; background: var(--tint);\n  display: grid; place-items: center; flex-shrink: 0; margin-top: 1px; }\n.checklist .ck .material-symbols-rounded { font-size: 16px; color: var(--orange); }\n.checklist b { font-weight: 600; }\n.checklist span { color: var(--mute); }\n\n/* bracket visual */\n.bracket { padding: 26px; }\n.brk-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; }\n.brk-head .bt { font-family: var(--display); font-weight: 700; font-size: 16px; }\n.brk-live { display: inline-flex; align-items: center; gap: 6px; font-family: var(--mono); font-size: 10px;\n  font-weight: 800; letter-spacing: 0.08em; color: var(--live); }\n.brk-cols { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 14px; align-items: center; }\n.brk-col { display: flex; flex-direction: column; gap: 12px; }\n.brk-col.r2 { justify-content: center; } .brk-col.r3 { justify-content: center; }\n.match { background: var(--s1); border: 1px solid var(--line); border-radius: 11px; overflow: hidden; }\n.match .row { display: flex; align-items: center; justify-content: space-between; padding: 8px 11px;\n  font-size: 12px; }\n.match .row + .row { border-top: 1px solid var(--line); }\n.match .row.w { color: var(--text); } .match .row.w .sc { color: var(--orange); }\n.match .row.l { color: var(--dim); }\n.match .nm { font-weight: 600; font-family: var(--ui); }\n.match .sc { font-family: var(--mono); font-weight: 700; }\n.match.champ { background: var(--tint); border-color: rgba(255,106,26,0.4); }\n.match.champ .row { color: var(--orange); justify-content: center; gap: 8px; font-family: var(--display);\n  font-weight: 700; font-size: 13px; }\n\n/* league table */\n.league { padding: 24px; margin-top: 18px; }\n.lg-head { display: flex; align-items: center; gap: 8px; margin-bottom: 14px;\n  font-family: var(--display); font-weight: 700; font-size: 15px; }\n.lg-head .material-symbols-rounded { font-size: 18px; color: var(--orange); }\n.lg-row { display: grid; grid-template-columns: 26px 1fr auto; align-items: center; gap: 12px;\n  padding: 10px 0; border-top: 1px solid var(--line); font-size: 13px; }\n.lg-row:first-of-type { border-top: none; }\n.lg-row .pos { font-family: var(--mono); font-weight: 700; color: var(--dim); }\n.lg-row.top .pos { color: var(--orange); }\n.lg-row .player { display: flex; align-items: center; gap: 9px; font-weight: 500; }\n.lg-row .player .a { width: 26px; height: 26px; border-radius: 50%; display: grid; place-items: center;\n  font-family: var(--display); font-weight: 700; font-size: 10px; color: #fff; }\n.lg-row .pts { font-family: var(--mono); font-weight: 700; }\n.lg-row.top .pts { color: var(--orange); }\n\n/* ═══ ARENAS ════════════════════════════════════════════════ */\n.arenas { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }\n.arena { overflow: hidden; padding: 0; }\n.arena image-slot { width: 100%; height: 188px; display: block; }\n.arena .ph { width: 100%; height: 188px; }\n.arena .ab { padding: 18px 20px 20px; }\n.arena .atop { display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px; }\n.arena h3 { font-size: 18px; }\n.arena .badge { font-family: var(--mono); font-size: 9px; font-weight: 700; letter-spacing: 0.08em;\n  color: var(--win); display: inline-flex; align-items: center; gap: 4px; }\n.arena .badge .d { width: 6px; height: 6px; border-radius: 50%; background: var(--win); }\n.arena .ameta { display: flex; align-items: center; gap: 6px; color: var(--mute); font-size: 13px; }\n.arena .ameta .material-symbols-rounded { font-size: 15px; color: var(--dim); }\n.arena .acourts { margin-top: 14px; display: flex; gap: 7px; flex-wrap: wrap; }\n.arena .chip { font-family: var(--mono); font-size: 10px; font-weight: 600; color: var(--mute);\n  background: var(--s1); border: 1px solid var(--line); border-radius: 999px; padding: 5px 10px; }\n\n.arena-cta { margin-top: 36px; padding: 36px 40px; display: flex; align-items: center;\n  justify-content: space-between; gap: 30px; flex-wrap: wrap;\n  background: linear-gradient(120deg, var(--tint), rgba(255,106,26,0.02));\n  border: 1px solid rgba(255,106,26,0.22); border-radius: 24px; }\n.arena-cta h3 { font-size: 24px; margin-bottom: 8px; }\n.arena-cta p { color: var(--mute); margin: 0; font-size: 15px; max-width: 52ch; }\n\n/* ═══ DEPOIMENTOS ═══════════════════════════════════════════ */\n.testimonials { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }\n.tst { padding: 28px 26px; display: flex; flex-direction: column; }\n.tst .stars { display: flex; gap: 2px; margin-bottom: 16px; color: var(--orange); }\n.tst .stars .material-symbols-rounded { font-size: 17px; font-variation-settings: 'FILL' 1; }\n.tst .quote { font-size: 16px; line-height: 1.55; color: var(--text); margin: 0 0 22px; text-wrap: pretty;\n  flex: 1; }\n.tst .who { display: flex; align-items: center; gap: 12px; }\n.tst .who image-slot { width: 44px; height: 44px; border-radius: 50%; flex-shrink: 0; }\n.tst .who .ph { width: 44px; height: 44px; }\n.tst .who .nm { font-family: var(--display); font-weight: 700; font-size: 14px; }\n.tst .who .rl { font-size: 12px; color: var(--mute); }\n\n/* ═══ CTA FINAL ═════════════════════════════════════════════ */\n.final { position: relative; overflow: hidden; }\n.final-card { position: relative; border-radius: 32px; padding: clamp(48px, 6vw, 80px);\n  background: linear-gradient(150deg, #1a0d05 0%, #0B0B0C 60%); border: 1px solid rgba(255,106,26,0.25);\n  overflow: hidden; text-align: center; }\n.final-card .fglow { position: absolute; top: -40%; left: 50%; transform: translateX(-50%);\n  width: 700px; height: 700px; background: radial-gradient(circle, rgba(255,106,26,0.28), transparent 60%);\n  filter: blur(20px); pointer-events: none; }\n.final-card .content { position: relative; z-index: 2; }\n.final-card h2 { font-size: clamp(32px, 4.5vw, 54px); margin-bottom: 18px; }\n.final-card p { color: var(--mute); font-size: 18px; max-width: 48ch; margin: 0 auto 34px; }\n.countdown { display: flex; justify-content: center; gap: 14px; margin: 0 auto 38px; }\n.cd-unit { min-width: 84px; padding: 16px 12px; border-radius: 16px; background: rgba(5,5,5,0.5);\n  border: 1px solid var(--line-2); }\n.cd-unit .v { font-family: var(--display); font-weight: 800; font-size: 36px; letter-spacing: -0.03em;\n  color: var(--text); line-height: 1; }\n.cd-unit .u { font-family: var(--mono); font-size: 10px; font-weight: 600; letter-spacing: 0.12em;\n  text-transform: uppercase; color: var(--mute); margin-top: 8px; }\n.final-card .stores { justify-content: center; }\n\n/* ═══ FOOTER ════════════════════════════════════════════════ */\n.footer { border-top: 1px solid var(--line); padding: 60px 0 40px; }\n.foot-grid { display: grid; grid-template-columns: 1.6fr 1fr 1fr 1fr; gap: 40px; margin-bottom: 48px; }\n.foot-brand p { color: var(--mute); font-size: 14px; margin: 18px 0 0; max-width: 32ch; }\n.ig-handle { display: inline-flex; align-items: center; gap: 8px; margin-top: 16px;\n  font-family: var(--mono); font-size: 13px; font-weight: 600; color: var(--mute);\n  padding: 8px 14px; border-radius: 999px; background: var(--s1); border: 1px solid var(--line);\n  transition: color .15s, border-color .15s; }\n.ig-handle:hover { color: var(--orange); border-color: rgba(255,106,26,0.4); }\n.ig-handle .material-symbols-rounded { font-size: 17px; }\n.foot-col h4 { font-family: var(--display); font-weight: 700; font-size: 13px; margin: 0 0 16px;\n  text-transform: uppercase; letter-spacing: 0.06em; color: var(--mute); }\n.foot-col a { display: block; font-size: 14px; color: var(--mute); padding: 6px 0;\n  transition: color .15s; }\n.foot-col a:hover { color: var(--orange); }\n.foot-bottom { display: flex; align-items: center; justify-content: space-between; gap: 20px;\n  padding-top: 28px; border-top: 1px solid var(--line); flex-wrap: wrap; }\n.foot-bottom .cp { font-size: 13px; color: var(--dim); }\n.foot-social { display: flex; gap: 10px; }\n.foot-social a { width: 40px; height: 40px; border-radius: 11px; background: var(--s1);\n  border: 1px solid var(--line); display: grid; place-items: center; color: var(--mute); transition: all .15s; }\n.foot-social a:hover { color: var(--orange); border-color: rgba(255,106,26,0.4); }\n.foot-social .material-symbols-rounded { font-size: 19px; }\n\n/* ═══ RESPONSIVE ════════════════════════════════════════════ */\n@media (max-width: 980px) {\n  .nav-links { display: none; }\n  .nav-toggle { display: grid; }\n  .nav-cta .btn { display: none; }\n  .hero-grid { grid-template-columns: 1fr; gap: 60px; }\n  .hero-copy { max-width: 100%; }\n  .hero-phone { order: -1; }\n  .split { grid-template-columns: 1fr; gap: 40px; }\n  .features { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n  .feature.big { grid-column: span 2; }\n  .steps { grid-template-columns: repeat(2, 1fr); }\n  .step .ln { display: none; }\n  .arenas, .testimonials { grid-template-columns: repeat(2, 1fr); }\n  .stats-inner { grid-template-columns: repeat(2, 1fr); }\n  .stat:nth-child(2) { border-right: none; }\n  .stat:nth-child(1), .stat:nth-child(2) { border-bottom: 1px solid var(--line); }\n\n  /* mobile nav panel */\n  .nav-panel { display: none; }\n  .nav-panel.open { display: flex; }\n}\n\n@media (max-width: 620px) {\n  .wrap { padding: 0 20px; }\n  .hero { padding-top: 120px; padding-bottom: 60px; }\n  .hero-copy { text-align: center; }\n  .hero-grid { grid-template-columns: minmax(0, 1fr); }\n  .hero-copy .launch-pill { white-space: normal; }\n  .hero-copy .hero-sub { margin-left: auto; margin-right: auto; }\n  .hero-actions { align-items: center; }\n  .hero-actions .stores { justify-content: center; }\n  .hero-proof { justify-content: center; }\n  .features, .steps, .arenas, .testimonials, .stats-inner { grid-template-columns: minmax(0, 1fr); }\n  .feature.big { grid-column: span 1; display: block; }\n  .feature.big .fb-txt { margin-bottom: 20px; }\n  .stat { border-right: none; border-bottom: 1px solid var(--line); }\n  .stat:last-child { border-bottom: none; }\n  .float-score { left: -16px; transform: scale(0.86); }\n  .float-streak { right: -10px; transform: scale(0.86); }\n  .countdown { gap: 8px; }\n  .cd-unit { min-width: 64px; padding: 12px 8px; }\n  .cd-unit .v { font-size: 28px; }\n  .foot-grid { grid-template-columns: 1fr 1fr; gap: 28px; }\n  .foot-brand { grid-column: span 2; }\n  .arena-cta { flex-direction: column; align-items: flex-start; text-align: left; }\n}\n\n@media (max-width: 400px) {\n  .hero { padding-top: 110px; }\n  .hero-phone { transform: scale(0.84); transform-origin: top center; }\n}\n\n/* role selector — mobile */\n@media (max-width: 560px) {\n  .como-tabs { width: 100%; gap: 4px; padding: 5px; }