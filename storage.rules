rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function hasRoleClaim(r) {
      return request.auth != null && (
        (request.auth.token.roles is list && r in request.auth.token.roles) ||
        request.auth.token.role == r
      );
    }

    // Regras para fotos de perfil: profiles/{userId}/*
    match /profiles/{userId}/{fileName} {
      // Usuários podem ler suas próprias fotos e fotos de outros usuários (para exibição em perfis)
      allow read: if request.auth != null;

      // Escrita: dono da foto ou admin
      allow write: if request.auth != null && (
        request.auth.uid == userId ||
        hasRoleClaim('admin')
      );
    }

    // Galeria de fotos de destaque: profiles/{userId}/highlights/{fileName}
    // (path com um segmento a mais do que o bloco acima, precisa de match próprio)
    match /profiles/{userId}/highlights/{fileName} {
      allow read: if request.auth != null;

      allow write: if request.auth != null && (
        request.auth.uid == userId ||
        hasRoleClaim('admin')
      );
    }

    // Regras para mídia do perfil do atleta: athletes/{userId}/*
    match /athletes/{userId}/{fileName} {
      // Leitura autenticada para renderizar perfis no app.
      allow read: if request.auth != null;

      // Escrita: dono da mídia ou admin
      allow write: if request.auth != null && (
        request.auth.uid == userId ||
        hasRoleClaim('admin')
      );
    }

    // Capas de ligas: leagues/{leagueId}/cover.jpg
    match /leagues/{leagueId}/{filePath=**} {
      allow read: if request.auth != null;

      allow write: if request.auth != null && (
        hasRoleClaim('admin') ||
        (
          firestore.get(/databases/(default)/documents/leagues/$(leagueId)).data.managerId
            == request.auth.uid
        )
      );
    }

    // Regras para imagens de torneios (inclui logos de patrocinadores): tournaments/{tournamentId}/**
    match /tournaments/{tournamentId}/{filePath=**} {
      // Qualquer usuário autenticado pode ler imagens de torneios
      allow read: if request.auth != null;
      
      // Escrita: admin ou gestor dono do torneio (capa/regulamento)
      allow write: if request.auth != null && (
        hasRoleClaim('admin') ||
        (
          firestore.get(/databases/(default)/documents/tournaments/$(tournamentId)).data.managerId
            == request.auth.uid
        )
      );
    }

    // Depoimentos: foto e logo - leitura pública; escrita apenas super admin
    match /testimonials/{testimonialId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.superAdmin == true;
    }

    // Patrocinadores da plataforma: logos e banners
    match /platformSponsors/{sponsorId}/{filePath=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.superAdmin == true;
    }

    // Arenas: logo da arena e fotos das quadras
    match /arenas/{arenaId}/{filePath=**} {
      allow read: if true;
      allow write: if request.auth != null && (
        firestore.get(/databases/(default)/documents/arenas/$(arenaId)).data.managerUserId == request.auth.uid ||
        hasRoleClaim('arena') ||
        hasRoleClaim('admin') ||
        request.auth.token.superAdmin == true
      );
    }

    // Membro da equipe da arena que escreve numa área do Firestore. ESPELHO MANUAL de
    // `isActiveArenaStaff` + `arenaWriteAreas` + `arenaEntitled` em firestore.rules: vínculo
    // ativo, cargo em [roles] (os cargos da área, listados em cada bloco abaixo) e titularidade
    // de plano pago. Lê 2 documentos (staff e arena), o teto de `firestore.get` por avaliação
    // no Storage.
    function arenaStaffWrites(arenaId, roles) {
      let staff = /databases/(default)/documents/arenas/$(arenaId)/staff/$(request.auth.uid);
      return firestore.exists(staff) &&
        firestore.get(staff).data.get('status', '') == 'active' &&
        firestore.get(staff).data.get('role', '') in roles &&
        arenaEntitled(arenaId);
    }
    function arenaEntitled(arenaId) {
      let a = firestore.get(/databases/(default)/documents/arenas/$(arenaId)).data;
      let status = a.get('planStatus', 'none');
      let until = a.get('planActiveUntil', null);
      return (a.get('planTier', '') in ['pro', 'elite', 'parceiro']) && (
        status == 'active' ||
        (status == 'overdue' && until != null &&
          request.time < until + duration.value(7, 'd')) ||
        (status == 'canceling' && until != null && request.time < until)
      );
    }
    // Apagar, ou subir imagem jpeg/png/webp de até 5 MB.
    function arenaStaffImage() {
      return request.resource == null || (
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|png|webp)')
      );
    }

    // Capa e logo da arena (Perfil do portal da arena e do app). Soma-se ao bloco
    // `arenas/{arenaId}/**`, que segue valendo para o dono e as claims: aqui entra o membro da
    // equipe que já edita o perfil no Firestore (`arenaCanWrite(arenaId, 'perfil')`).
    match /arenas/{arenaId}/{image} {
      // Cargos com escrita em `perfil` no `arenaWriteAreas` (o teste confere a paridade).
      function arenaPerfilRoles() {
        return ['gestor'];
      }
      allow write: if request.auth != null && image in ['cover', 'logo'] &&
        arenaStaffWrites(arenaId, arenaPerfilRoles()) && arenaStaffImage();
    }

    // Foto de produto do estoque (app: `ArenaProductsRepository.uploadProductImage`). Soma-se
    // ao bloco `arenas/{arenaId}/**` (dono e claims): aqui entra o membro que já grava o
    // produto no Firestore (`canManageArenaProducts`, ou seja `arenaCanWrite(arenaId,
    // 'estoque')`). O Firestore não pede tier além do Pro/Elite/Parceiro de `arenaEntitled`.
    match /arenas/{arenaId}/products/{fileName} {
      // Cargos com escrita em `estoque` no `arenaWriteAreas` (o teste confere a paridade).
      function arenaEstoqueRoles() {
        return ['gestor', 'manutencao'];
      }
      allow write: if request.auth != null &&
        arenaStaffWrites(arenaId, arenaEstoqueRoles()) && arenaStaffImage();
    }

    // Centro de treinamento: capa da vitrine de aulas no app. Leitura pública; escrita só do
    // gestor (dono/admin) com vínculo ativo, e só imagem de até 5 MB.
    match /trainingCenters/{centerId}/{filePath=**} {
      function ctManager() {
        let m = /databases/(default)/documents/trainingCenters/$(centerId)/centerMembers/$(request.auth.uid);
        return firestore.exists(m) &&
          firestore.get(m).data.status == 'active' &&
          firestore.get(m).data.role in ['center_owner', 'center_admin'];
      }
      allow read: if true;
      allow write: if request.auth != null && ctManager() &&
        (request.resource == null || (
          request.resource.size < 5 * 1024 * 1024 &&
          request.resource.contentType.matches('image/(jpeg|png|webp)')
        ));
    }

    // Atestado da pausa por lesão (CT): o próprio aluno envia (PDF ou foto até 10 MB, sem
    // sobrescrever); lê o aluno e owner/admin do centro. Fora de `trainingCenters/…`, que é público.
    match /trainingCenterCertificates/{centerId}/{userId}/{fileName} {
      function certManager() {
        let m = /databases/(default)/documents/trainingCenters/$(centerId)/centerMembers/$(request.auth.uid);
        return firestore.exists(m) &&
          firestore.get(m).data.status == 'active' &&
          firestore.get(m).data.role in ['center_owner', 'center_admin'];
      }
      allow read: if request.auth != null && (request.auth.uid == userId || certManager());
      allow create: if request.auth != null && request.auth.uid == userId &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('application/pdf|image/(jpeg|png|webp|heic)');
      allow update, delete: if false;
    }

    // Fotos do catálogo da Loja. Leitura pública (vitrine); escrita só admin,
    // e só imagem de até 10 MB. Quem registra a foto no produto é a callable.
    match /store/products/{productId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null &&
        (hasRoleClaim('admin') || request.auth.token.superAdmin == true) &&
        (request.method == 'delete' || (
          request.resource.size < 10 * 1024 * 1024 &&
          request.resource.contentType.matches('image/(jpeg|png|webp)')
        ));
    }

    // Imagem da personalização (Loja 02b/02c). O atleta sobe a dele; quem confere formato,
    // peso e resolução contra a config do produto é a callable addStoreCustomItemToCart. Leitura:
    // o dono e o admin (fila de arte, tela 10). Sem sobrescrever: cada envio é um arquivo novo.
    // 50 MB é o teto da config (`maxSizeMb`); o limite do produto vale na callable.
    match /store/custom-uploads/{userId}/{fileName} {
      allow read: if request.auth != null &&
        (request.auth.uid == userId || hasRoleClaim('admin') || request.auth.token.superAdmin == true);
      allow create: if request.auth != null && request.auth.uid == userId &&
        request.resource.size < 50 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|png|svg\\+xml)');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Fotos da avaliação da compra (Loja 06b/08b). O atleta sobe a dele; a callable
    // submitStoreOrderReview confere dono, tipo e peso e copia pra store/reviews/{productId}
    // (pública, sem o uid no caminho). Sem sobrescrever: cada envio é um arquivo novo.
    match /store/review-uploads/{userId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Cópia pública das fotos das avaliações publicadas. Só o servidor grava.
    match /store/reviews/{productId}/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    // Fotos dos banners de campanha da vitrine. Mesmo regime das fotos do catálogo:
    // leitura pública, escrita só admin e só imagem até 10 MB. Quem liga a foto ao
    // banner é a callable saveStoreCampaigns.
    match /store/campaigns/{fileName} {
      allow read: if true;
      allow write: if request.auth != null &&
        (hasRoleClaim('admin') || request.auth.token.superAdmin == true) &&
        (request.method == 'delete' || (
          request.resource.size < 10 * 1024 * 1024 &&
          request.resource.contentType.matches('image/(jpeg|png|webp)')
        ));
    }

    // Imagens do banner de novidades da Home do app (backoffice › App do atleta). Leitura
    // pública como as da vitrine; escrita só admin e só imagem até 5 MB. Quem liga a imagem
    // ao banner é a callable saveHomeBanners.
    match /app/home-banners/{fileName} {
      allow read: if true;
      allow write: if request.auth != null &&
        (hasRoleClaim('admin') || request.auth.token.superAdmin == true) &&
        (request.method == 'delete' || (
          request.resource.size < 5 * 1024 * 1024 &&
          request.resource.contentType.matches('image/(jpeg|png|webp)')
        ));
    }

    // Imagens das funcionalidades da tela de Novidades do app (backoffice › App do atleta ›
    // Novidades). Mesmas condições do banner; quem liga a imagem à funcionalidade é a callable
    // saveAppNews.
    match /app/news/{fileName} {
      allow read: if true;
      allow write: if request.auth != null &&
        (hasRoleClaim('admin') || request.auth.token.superAdmin == true) &&
        (request.method == 'delete' || (
          request.resource.size < 5 * 1024 * 1024 &&
          request.resource.contentType.matches('image/(jpeg|png|webp)')
        ));
    }

    // Imagens dos guias da Central de ajuda do app (backoffice › App do atleta › Central de
    // ajuda). Mesmas condições das Novidades; quem liga a imagem ao guia é a callable saveAppGuide.
    match /app/guide/{fileName} {
      allow read: if true;
      allow write: if request.auth != null &&
        (hasRoleClaim('admin') || request.auth.token.superAdmin == true) &&
        (request.method == 'delete' || (
          request.resource.size < 5 * 1024 * 1024 &&
          request.resource.contentType.matches('image/(jpeg|png|webp)')
        ));
    }

    // Anexos das entradas de estoque (NF em PDF/XML, fotos da caixa). Documento
    // fiscal: leitura só admin, diferente das fotos do catálogo.
    match /store/stock/{entryId}/{fileName} {
      allow read: if request.auth != null &&
        (hasRoleClaim('admin') || request.auth.token.superAdmin == true);
      allow write: if request.auth != null &&
        (hasRoleClaim('admin') || request.auth.token.superAdmin == true) &&
        (request.method == 'delete' || (
          request.resource.size < 20 * 1024 * 1024 &&
          request.resource.contentType.matches('application/pdf|application/xml|text/xml|image/(jpeg|png|webp)')
        ));
    }

    // Fotos de trocas & devoluções (produto com defeito, etiqueta). Dado do cliente: só admin.
    match /store/returns/{returnId}/{fileName} {
      allow read: if request.auth != null &&
        (hasRoleClaim('admin') || request.auth.token.superAdmin == true);
      allow write: if request.auth != null &&
        (hasRoleClaim('admin') || request.auth.token.superAdmin == true) &&
        (request.method == 'delete' || (
          request.resource.size < 10 * 1024 * 1024 &&
          request.resource.contentType.matches('image/(jpeg|png|webp)')
        ));
    }

    // Regras padrão - nega acesso a outras pastas não especificadas
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
