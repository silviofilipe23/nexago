# NexaGO — Site público (SPA Angular) em Apache/LiteSpeed (Hostinger).
# Mesmo padrão do target "athlete": fallback pra index.html, hashed assets imutáveis,
# resto sem cache. Usado só a partir do corte de deploy (fase 4 da migração) — ver
# [[site-deploy]]. Até lá o Next.js legado continua sendo o site publicado.

Options -Indexes

# --- Tipos MIME ------------------------------------------------------------
<IfModule mod_mime.c>
  AddType application/javascript          .mjs
  AddType application/manifest+json       .webmanifest
  AddType application/json                .json
  AddType image/svg+xml                   .svg
  AddType video/mp4                       .mp4
</IfModule>

# --- Compressão ------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain \
    application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

# --- Cache -----------------------------------------------------------------
<IfModule mod_headers.c>
  <FilesMatch "\.(js|mjs|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|webmanifest|json|ico|png|jpg|jpeg|webp|svg|mp4)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# --- Roteamento da SPA -----------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ index.html [L]
</IfModule>

# --- Fallback de 404 (caso mod_rewrite esteja desligado) --------------------
ErrorDocument 404 /index.html
