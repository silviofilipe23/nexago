{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "baseUrl": "./",
    "paths": {
      "@nexago/firebase-config": ["shared/firebase/firebase.config.ts"],
      "@nexago/arena-discovery": ["shared/arena-discovery/index.ts"],
      "@nexago/br-locations": ["shared/br-locations/index.ts"],
      "@nexago/leagues": ["shared/leagues/index.ts"],
      "@nexago/levels": ["shared/levels/index.ts"],
      "@nexago/link-pages": ["shared/link-pages/index.ts"],
      "@nexago/push-notifications": ["shared/push-notifications/index.ts"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "typeCheckHostBindings": true,
    "strictTemplates": true
  },
  "files": [],
  "references": [
    {
      "path": "./projects/arena/tsconfig.app.json"
    },
    {
      "path": "./projects/arena/tsconfig.spec.json"
    },
    {
      "path": "./projects/athlete/tsconfig.app.json"
    },
    {
      "path": "./projects/athlete/tsconfig.spec.json"
    },
    {
      "path": "./projects/backoffice/tsconfig.app.json"
    },
    {
      "path": "./projects/backoffice/tsconfig.spec.json"
    },
    {
      "path": "./projects/coach/tsconfig.app.json"
    },
    {
      "path": "./projects/coach/tsconfig.spec.json"
    },
    {
      "path": "./projects/organizer/tsconfig.app.json"
    },
    {
      "path": "./projects/organizer/tsconfig.spec.json"
    }
  ]
}
