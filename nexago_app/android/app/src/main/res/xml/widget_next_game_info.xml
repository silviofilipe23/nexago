<?xml version="1.0" encoding="utf-8"?>
<!-- Widget "Próximo jogo" (W1). O app regrava os dados quando a Agenda carrega
     e ao ir para segundo plano; o widget agenda a própria atualização no início
     e no fim do próximo compromisso, e o sistema ainda atualiza a cada 30 min. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_next_game"
    android:previewLayout="@layout/widget_next_game"
    android:description="@string/widget_next_game_description"
    android:widgetCategory="home_screen" />
