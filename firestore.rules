rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    // Multi-role: claim `roles` (lista); fallback ao claim legado `role` durante migração
    function hasRoleClaim(r) {
      return request.auth != null && (
        (request.auth.token.roles is list && r in request.auth.token.roles) ||
        (('role' in request.auth.token) && request.auth.token.role == r)
      );
    }

    function isAdmin() {
      return request.auth != null && hasRoleClaim('admin');
    }
    function isSuperAdmin() {
      return request.auth != null &&
        ('superAdmin' in request.auth.token) &&
        request.auth.token.superAdmin == true;
    }
    function isArena() {
      return request.auth != null && hasRoleClaim('arena');
    }
    /** Gestor de torneios (backoffice operacional); não confundir com admin da plataforma. */
    function isTournamentOrganizer() {
      return request.auth != null && hasRoleClaim('organizer');
    }
    function isValidTournamentListingStatus(status) {
      return status is string && status in ['draft', 'open'];
    }
    function isValidLeagueListingStatus(status) {
      return status is string && status in ['draft', 'open', 'closed', 'cancelled'];
    }
    function leagueListingStatusTransitionAllowed(before, after) {
      return before == after ||
        (before == 'draft' && after in ['open', 'cancelled']) ||
        (before == 'open' && after in ['closed', 'cancelled']);
    }
    function organizerCanUpdateOwnLeague() {
      return request.auth != null &&
        resource.data.managerId == request.auth.uid &&
        request.resource.data.managerId == resource.data.managerId &&
        isValidLeagueListingStatus(request.resource.data.listingStatus) &&
        leagueListingStatusTransitionAllowed(
          resource.data.listingStatus,
          request.resource.data.listingStatus
        );
    }
    function organizerCanCreateTournament() {
      return request.auth != null &&
        isTournamentOrganizer() &&
        request.resource.data.managerId == request.auth.uid &&
        request.resource.data.name is string &&
        request.resource.data.name.size() >= 3 &&
        request.resource.data.city is string &&
        request.resource.data.locationName is string &&
        request.resource.data.startAt is timestamp &&
        request.resource.data.endAt is timestamp &&
        request.resource.data.listingStatus is string &&
        isValidTournamentListingStatus(request.resource.data.listingStatus) &&
        request.resource.data.enrolledCount == 0 &&
        (!('collectedCents' in request.resource.data) ||
         request.resource.data.collectedCents == 0) &&
        request.resource.data.categories is list &&
        request.resource.data.categories.size() >= 1;
    }
    function organizerCanUpdateOwnTournament() {
      return request.auth != null &&
        resource.data.managerId == request.auth.uid &&
        request.resource.data.managerId == resource.data.managerId &&
        request.resource.data.enrolledCount == resource.data.enrolledCount &&
        request.resource.data.collectedCents == resource.data.collectedCents &&
        request.resource.data.listingStatus is string &&
        isValidTournamentListingStatus(request.resource.data.listingStatus);
    }
    function isTournamentOwner(tournamentId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/tournaments/$(tournamentId)) &&
        get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.managerId == request.auth.uid;
    }
    function isTournamentStaff(tournamentId, allowedRoles) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/tournaments/$(tournamentId)/staff/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/tournaments/$(tournamentId)/staff/$(request.auth.uid)).data.status == 'active' &&
        allowedRoles.hasAny([
          get(/databases/$(database)/documents/tournaments/$(tournamentId)/staff/$(request.auth.uid)).data.role
        ]);
    }
    function canManageTournament(tournamentId) {
      return request.auth != null && (
        isAdmin() ||
        isSuperAdmin() ||
        isTournamentOwner(tournamentId) ||
        isTournamentStaff(tournamentId, ['manager'])
      );
    }
    function canScoreTournament(tournamentId) {
      return request.auth != null && (
        isAdmin() ||
        isSuperAdmin() ||
        isTournamentOwner(tournamentId) ||
        isTournamentStaff(tournamentId, ['manager', 'scorer'])
      );
    }
    function scorerCanOnlyEditScoreFields() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
        'resultA',
        'resultB',
        'winnerId',
        'status',
        'sets',
        'currentSetIndex',
        'matchStartedAt',
        'matchEndedAt',
        'lastActions',
        'pointEventSeq',
        'updatedAt'
      ]);
    }
    function inscriptionParticipantUidsMatchTeam(appId, teamId) {
      return !('participantUids' in request.resource.data) ||
        (
          request.resource.data.participantUids is list &&
          request.resource.data.participantUids.size() == 2 &&
          exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/teams/$(teamId)) &&
          (
            (
              request.resource.data.participantUids[0] == get(/databases/$(database)/documents/artifacts/$(appId)/public/data/teams/$(teamId)).data.player1Id &&
              request.resource.data.participantUids[1] == get(/databases/$(database)/documents/artifacts/$(appId)/public/data/teams/$(teamId)).data.player2Id
            ) ||
            (
              request.resource.data.participantUids[0] == get(/databases/$(database)/documents/artifacts/$(appId)/public/data/teams/$(teamId)).data.player2Id &&
              request.resource.data.participantUids[1] == get(/databases/$(database)/documents/artifacts/$(appId)/public/data/teams/$(teamId)).data.player1Id
            )
          )
        );
    }
    function inscriptionParticipantUidsImmutable() {
      return !('participantUids' in request.resource.data) ||
        request.resource.data.participantUids == resource.data.participantUids;
    }
    function inscriptionCoreFieldsImmutable() {
      return request.resource.data.tournamentId == resource.data.tournamentId &&
        request.resource.data.categoryId == resource.data.categoryId &&
        request.resource.data.teamId == resource.data.teamId;
    }
    function inscriptionPaymentFieldsUnchanged() {
      return (!('isPaid' in request.resource.data) ||
              request.resource.data.isPaid == resource.data.isPaid) &&
        (!('paidAmount' in request.resource.data) ||
         request.resource.data.paidAmount == resource.data.paidAmount) &&
        (!('sharePaidUids' in request.resource.data) ||
         request.resource.data.sharePaidUids == resource.data.sharePaidUids) &&
        (!('paidAt' in request.resource.data) ||
         request.resource.data.paidAt == resource.data.paidAt);
    }
    function inscriptionEnrollmentFieldsUnchanged() {
      return (!('waitlist' in request.resource.data) ||
              request.resource.data.waitlist == resource.data.waitlist);
    }
    function inscriptionCreatePaymentSafe() {
      return (!('isPaid' in request.resource.data) ||
              request.resource.data.isPaid == false) &&
        (!('paidAmount' in request.resource.data) ||
         request.resource.data.paidAmount == 0) &&
        (!('sharePaidUids' in request.resource.data) ||
         request.resource.data.sharePaidUids.size() == 0) &&
        !('paidAt' in request.resource.data);
    }
    function teamPlayerIdsUnchanged() {
      return request.resource.data.player1Id == resource.data.player1Id &&
        request.resource.data.player2Id == resource.data.player2Id;
    }
    function managerCanOnlyEditMatchFields() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
        'courtId',
        'courtName',
        'scheduleTime',
        'scheduleEndTime',
        'dayKey',
        'queueOrder',
        'queueStatus',
        'checkIn',
        'servingTeamId',
        'report',
        'liveElapsedSec',
        'resultA',
        'resultB',
        'winnerId',
        'status',
        'sets',
        'currentSetIndex',
        'matchStartedAt',
        'matchEndedAt',
        'lastActions',
        'pointEventSeq',
        'updatedAt'
      ]) &&
        request.resource.data.teamAId == resource.data.teamAId &&
        request.resource.data.teamBId == resource.data.teamBId &&
        request.resource.data.tournamentId == resource.data.tournamentId &&
        request.resource.data.categoryId == resource.data.categoryId;
    }
    function matchDoc(appId, matchId) {
      return get(/databases/$(database)/documents/artifacts/$(appId)/public/data/matches/$(matchId));
    }
    function canWriteMatchPointEvents(appId, matchId) {
      return request.auth != null && matchDoc(appId, matchId).data != null && (
        isAdmin() ||
        isSuperAdmin() ||
        canManageTournament(matchDoc(appId, matchId).data.tournamentId) ||
        canScoreTournament(matchDoc(appId, matchId).data.tournamentId)
      );
    }
    function isValidPointEventCreate(appId, matchId) {
      let expectedSeq = matchDoc(appId, matchId).data.get('pointEventSeq', 0) + 1;
      return request.resource.data.keys().hasAll(['seq', 'type', 'setIndex', 'scoreA', 'scoreB', 'ts']) &&
        request.resource.data.seq is int &&
        request.resource.data.seq == expectedSeq &&
        request.resource.data.type in ['match-start', 'point', 'set-end', 'undo-point', 'undo-set-end', 'match-end'] &&
        request.resource.data.setIndex is int &&
        request.resource.data.setIndex >= 0 &&
        request.resource.data.setIndex <= 2 &&
        request.resource.data.scoreA is int &&
        request.resource.data.scoreB is int &&
        request.resource.data.scoreA >= 0 &&
        request.resource.data.scoreB >= 0 &&
        request.resource.data.ts is timestamp;
    }
    function organizerCanCreateOperationalTorneio() {
      return request.auth != null &&
        isTournamentOrganizer() &&
        request.resource.data.managerId == request.auth.uid;
    }
    function organizerCanUpdateOwnOperationalTorneio() {
      return request.auth != null &&
        isTournamentOrganizer() &&
        resource.data.managerId == request.auth.uid &&
        request.resource.data.managerId == resource.data.managerId;
    }
    function organizerCanDeleteOwnOperationalTorneio() {
      return request.auth != null &&
        isTournamentOrganizer() &&
        resource.data.managerId == request.auth.uid;
    }

    function userDocIsPublicAthlete(resource) {
      return resource != null && (
        resource.data.hasAthleteRole == true ||
        (resource.data.roles is list && 'athlete' in resource.data.roles) ||
        resource.data.role == 'athlete'
      );
    }
    /** Atleta logado pré-cadastra parceiro sem conta (inscrição em torneio). */
    function authUserHasAthleteProfile() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'athlete' ||
          (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles is list &&
            'athlete' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles
          )
        );
    }
    function inviterCanPreRegisterPartner() {
      return request.auth != null && (
        hasRoleClaim('athlete') ||
        authUserHasAthleteProfile()
      );
    }
    function isPartnerPreRegistrationCreate(targetUserId) {
      return request.auth != null &&
        request.auth.uid != targetUserId &&
        inviterCanPreRegisterPartner() &&
        request.resource.data.role == 'athlete' &&
        request.resource.data.partnerInviteStatus == 'pending' &&
        request.resource.data.invitedByUid == request.auth.uid &&
        request.resource.data.fullName is string &&
        request.resource.data.fullName.size() > 0 &&
        request.resource.data.email is string &&
        request.resource.data.email.size() > 0 &&
        (
          !('roles' in request.resource.data) ||
          (
            request.resource.data.roles is list &&
            request.resource.data.roles.hasOnly(['athlete'])
          )
        ) &&
        (!('superAdmin' in request.resource.data) || request.resource.data.superAdmin == false);
    }
    function isPartnerPreRegistrationUpdateByInviter(targetUserId) {
      return request.auth != null &&
        request.auth.uid != targetUserId &&
        resource.data.partnerInviteStatus == 'pending' &&
        resource.data.invitedByUid == request.auth.uid &&
        request.resource.data.partnerInviteStatus == 'pending' &&
        request.resource.data.invitedByUid == request.auth.uid &&
        request.resource.data.role == 'athlete' &&
        (
          !('roles' in request.resource.data) ||
          (
            request.resource.data.roles is list &&
            request.resource.data.roles.hasOnly(['athlete'])
          )
        );
    }
    function isArenaManagerByArenaId(arenaId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/arenas/$(arenaId)) &&
        get(/databases/$(database)/documents/arenas/$(arenaId)).data.managerUserId == request.auth.uid;
    }
    function canManageArenaProducts(arenaId) {
      return request.auth != null && (
        isArenaManagerByArenaId(arenaId) ||
        isSuperAdmin()
      );
    }
    function isValidArenaProductCategory(category) {
      return category in ['bebidas', 'alimentacao', 'equipamentos', 'servicos'];
    }
    function isValidArenaProductData(data) {
      return data.name is string &&
        data.name.size() > 0 &&
        data.name.size() <= 120 &&
        data.nameLower is string &&
        data.nameLower.size() > 0 &&
        isValidArenaProductCategory(data.category) &&
        data.active is bool &&
        data.priceCents is int &&
        data.priceCents >= 0 &&
        data.priceCents <= 100000000 &&
        data.stockQuantity is int &&
        data.stockQuantity >= 0 &&
        data.stockQuantity <= 1000000 &&
        data.minStockQuantity is int &&
        data.minStockQuantity >= 0 &&
        data.minStockQuantity <= 1000000 &&
        (!('description' in data) || data.description == null || (data.description is string && data.description.size() <= 500)) &&
        (!('emoji' in data) || data.emoji == null || (data.emoji is string && data.emoji.size() <= 8)) &&
        (!('imageUrl' in data) || data.imageUrl == null || (data.imageUrl is string && data.imageUrl.size() <= 2048));
    }
    function isValidArenaStockMovementType(movementType) {
      return movementType in ['purchase', 'adjustment', 'loss', 'sale'];
    }
    function isValidArenaStockMovementCreate(arenaId, productId) {
      let productDoc = get(/databases/$(database)/documents/arenas/$(arenaId)/products/$(productId));
      let data = request.resource.data;
      return canManageArenaProducts(arenaId) &&
        productDoc.data != null &&
        data.keys().hasAll([
          'productId',
          'productName',
          'type',
          'quantityDelta',
          'quantityBefore',
          'quantityAfter',
          'createdAt',
          'createdByUid'
        ]) &&
        data.productId == productId &&
        data.productName is string &&
        data.productName.size() > 0 &&
        isValidArenaStockMovementType(data.type) &&
        isFirestoreInt(data.quantityDelta) &&
        firestoreIntValue(data.quantityDelta) != 0 &&
        isFirestoreInt(data.quantityBefore) &&
        firestoreIntValue(data.quantityBefore) >= 0 &&
        isFirestoreInt(data.quantityAfter) &&
        firestoreIntValue(data.quantityAfter) >= 0 &&
        firestoreIntValue(data.quantityAfter) ==
          firestoreIntValue(data.quantityBefore) +
          firestoreIntValue(data.quantityDelta) &&
        (
          firestoreIntValue(data.quantityBefore) == arenaProductStockQty(productDoc) ||
          firestoreIntValue(data.quantityAfter) == arenaProductStockQty(productDoc)
        ) &&
        isCreateTimestamp(data.createdAt) &&
        data.createdByUid == request.auth.uid &&
        (!('note' in data) || data.note == null || (data.note is string && data.note.size() <= 300));
    }
    function isValidArenaComandaStatus(status) {
      return status in ['open', 'closing', 'partiallyPaid', 'closed'];
    }
    function isValidArenaComandaType(type) {
      return type in ['shared', 'individual', 'table', 'event'];
    }
    function isValidArenaComandaCreate(data) {
      return data.keys().hasAll([
          'arenaId',
          'displayNumber',
          'type',
          'status',
          'customerName',
          'allowAppOrders',
          'rentalCents',
          'itemsTotalCents',
          'totalCents',
          'itemsCount',
          'openedByUid',
          'openedAt',
          'createdAt',
          'updatedAt'
        ]) &&
        data.arenaId is string &&
        data.arenaId.size() > 0 &&
        isArenaManagerByArenaId(data.arenaId) &&
        data.displayNumber is int &&
        data.displayNumber > 0 &&
        data.displayNumber <= 999999 &&
        isValidArenaComandaType(data.type) &&
        data.type == 'individual' &&
        data.status == 'open' &&
        data.customerName is string &&
        data.customerName.size() > 0 &&
        data.customerName.size() <= 120 &&
        data.allowAppOrders is bool &&
        data.rentalCents is int &&
        data.rentalCents >= 0 &&
        data.rentalCents <= 100000000 &&
        data.itemsTotalCents is int &&
        data.itemsTotalCents == 0 &&
        data.totalCents is int &&
        data.totalCents == data.rentalCents &&
        data.itemsCount is int &&
        data.itemsCount == 0 &&
        (!('paidCents' in data) || (data.paidCents is int && data.paidCents == 0)) &&
        data.openedByUid == request.auth.uid &&
        data.openedAt is timestamp &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        (!('bookingId' in data) || data.bookingId == null || (data.bookingId is string && data.bookingId.size() <= 128)) &&
        (!('bookingDisplayCode' in data) || data.bookingDisplayCode == null || (data.bookingDisplayCode is string && data.bookingDisplayCode.size() <= 32)) &&
        (!('locationLabel' in data) || data.locationLabel == null || (data.locationLabel is string && data.locationLabel.size() <= 120)) &&
        (!('customerWhatsapp' in data) || data.customerWhatsapp == null || (data.customerWhatsapp is string && data.customerWhatsapp.size() <= 32)) &&
        (!('customerCpf' in data) || data.customerCpf == null || (data.customerCpf is string && data.customerCpf.size() <= 14));
    }
    function isValidArenaComandaItemSource(source) {
      return source in ['counter', 'app'];
    }
    function isValidArenaComandaPaymentMethod(method) {
      return method in ['pix', 'credit', 'debit', 'cash', 'wallet', 'other'];
    }
    function arenaComandaPaidCents(data) {
      return 'paidCents' in data && data.paidCents is int
        ? data.paidCents
        : (
            'paidCents' in data && data.paidCents is number
              ? int(data.paidCents)
              : 0
          );
    }
    function arenaComandaRentalCents(data) {
      return 'rentalCents' in data && data.rentalCents is int
        ? data.rentalCents
        : (
            'rentalCents' in data && data.rentalCents is number
              ? int(data.rentalCents)
              : 0
          );
    }
    function arenaProductStockQty(productDoc) {
      return productDoc.data.stockQuantity is int
        ? productDoc.data.stockQuantity
        : (
            productDoc.data.stockQuantity is number
              ? int(productDoc.data.stockQuantity)
              : 0
          );
    }
    function isValidArenaProductStockUpdate() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'stockQuantity',
          'updatedAt'
        ]) &&
        isFirestoreInt(request.resource.data.stockQuantity) &&
        firestoreIntValue(request.resource.data.stockQuantity) >= 0 &&
        firestoreIntValue(request.resource.data.stockQuantity) <= 1000000 &&
        (
          request.resource.data.updatedAt is timestamp ||
          request.resource.data.updatedAt == request.time
        );
    }
    function arenaComandaStatusValue(data) {
      return data.status is string ? data.status : 'open';
    }
    function isCreateTimestamp(value) {
      return value is timestamp || value == request.time;
    }
    function isFirestoreInt(value) {
      return value is int || (value is number && value == int(value));
    }
    function firestoreIntValue(value) {
      return value is int ? value : int(value);
    }
    function comandaPaymentStateChanged() {
      return arenaComandaStatusValue(request.resource.data) !=
          arenaComandaStatusValue(resource.data) ||
        arenaComandaPaidCents(request.resource.data) !=
          arenaComandaPaidCents(resource.data);
    }
    function isValidArenaComandaItemCreate(comandaId, data) {
      let comandaDoc = get(/databases/$(database)/documents/arenaComandas/$(comandaId));
      return comandaDoc.data != null &&
        canManageArenaProducts(comandaDoc.data.arenaId) &&
        data.keys().hasAll([
          'productId',
          'productName',
          'quantity',
          'unitPriceCents',
          'lineTotalCents',
          'source',
          'addedByName',
          'addedByUid',
          'createdAt'
        ]) &&
        data.productId is string &&
        data.productId.size() > 0 &&
        data.productName is string &&
        data.productName.size() > 0 &&
        data.productName.size() <= 120 &&
        isFirestoreInt(data.quantity) &&
        firestoreIntValue(data.quantity) > 0 &&
        firestoreIntValue(data.quantity) <= 99 &&
        isFirestoreInt(data.unitPriceCents) &&
        firestoreIntValue(data.unitPriceCents) >= 0 &&
        firestoreIntValue(data.unitPriceCents) <= 100000000 &&
        isFirestoreInt(data.lineTotalCents) &&
        firestoreIntValue(data.lineTotalCents) ==
          firestoreIntValue(data.unitPriceCents) * firestoreIntValue(data.quantity) &&
        isValidArenaComandaItemSource(data.source) &&
        data.addedByName is string &&
        data.addedByName.size() > 0 &&
        data.addedByName.size() <= 120 &&
        data.addedByUid == request.auth.uid &&
        isCreateTimestamp(data.createdAt) &&
        (!('emoji' in data) || data.emoji == null || (data.emoji is string && data.emoji.size() <= 16));
    }
    function isValidArenaComandaItemDelete(comandaId) {
      let comandaDoc = get(/databases/$(database)/documents/arenaComandas/$(comandaId));
      let status = arenaComandaStatusValue(comandaDoc.data);
      return comandaDoc.data != null &&
        canManageArenaProducts(comandaDoc.data.arenaId) &&
        status in ['open', 'closing', 'partiallyPaid'];
    }
    function isValidArenaComandaPaymentCreate(comandaId, data) {
      let comandaDoc = get(/databases/$(database)/documents/arenaComandas/$(comandaId));
      return comandaDoc.data != null &&
        canManageArenaProducts(comandaDoc.data.arenaId) &&
        data.keys().hasAll([
          'method',
          'amountCents',
          'payerName',
          'receivedByUid',
          'createdAt'
        ]) &&
        isValidArenaComandaPaymentMethod(data.method) &&
        data.amountCents is int &&
        data.amountCents > 0 &&
        data.amountCents <= 100000000 &&
        data.payerName is string &&
        data.payerName.size() > 0 &&
        data.payerName.size() <= 120 &&
        data.receivedByUid == request.auth.uid &&
        isCreateTimestamp(data.createdAt);
    }
    function isValidArenaComandaUpdate() {
      return         request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'status',
          'itemsTotalCents',
          'totalCents',
          'itemsCount',
          'paidCents',
          'rentalCents',
          'updatedAt'
        ]) &&
        isValidArenaComandaStatus(
          arenaComandaStatusValue(request.resource.data)
        ) &&
        request.resource.data.itemsTotalCents is int &&
        request.resource.data.itemsTotalCents >= 0 &&
        request.resource.data.totalCents is int &&
        request.resource.data.totalCents ==
          arenaComandaRentalCents(resource.data) +
          request.resource.data.itemsTotalCents &&
        request.resource.data.itemsCount is int &&
        request.resource.data.itemsCount >= 0 &&
        (
          request.resource.data.updatedAt is timestamp ||
          request.resource.data.updatedAt == request.time
        ) &&
        (
          !comandaPaymentStateChanged() ||
          (
            arenaComandaPaidCents(request.resource.data) >= 0 &&
            arenaComandaPaidCents(request.resource.data) <=
              request.resource.data.totalCents &&
            (
              arenaComandaStatusValue(request.resource.data) == 'closed'
                ? arenaComandaPaidCents(request.resource.data) >=
                  request.resource.data.totalCents
                : true
            ) &&
            (
              arenaComandaStatusValue(request.resource.data) == 'partiallyPaid'
                ? arenaComandaPaidCents(request.resource.data) > 0 &&
                  arenaComandaPaidCents(request.resource.data) <
                    request.resource.data.totalCents
                : true
            )
          )
        );
    }

    // Regras para arenas
    match /arenas/{arenaId} {
      allow read: if true;
      allow create: if request.auth != null && (isAdmin() || isSuperAdmin() || isArena());
      allow update, delete: if request.auth != null && (
        resource.data.managerUserId == request.auth.uid ||
        isAdmin() ||
        isSuperAdmin()
      );
    }
    match /arenas/{arenaId}/courts/{courtId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && (
        get(/databases/$(database)/documents/arenas/$(arenaId)).data.managerUserId == request.auth.uid ||
        isSuperAdmin()
      );
    }
    match /arenas/{arenaId}/followers/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.arenaId == arenaId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    match /arenas/{arenaId}/promotions/{promoId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && (
        get(/databases/$(database)/documents/arenas/$(arenaId)).data.managerUserId == request.auth.uid ||
        isSuperAdmin()
      );
    }
    match /arenaWallets/{arenaId} {
      allow read: if request.auth != null && (
        isSuperAdmin() ||
        isAdmin() ||
        (
          exists(/databases/$(database)/documents/arenas/$(arenaId)) &&
          get(/databases/$(database)/documents/arenas/$(arenaId)).data.managerUserId == request.auth.uid
        )
      );
      allow create, update, delete: if false;
      match /ledger/{entryId} {
        allow read: if request.auth != null && (
          isSuperAdmin() ||
          isAdmin() ||
          (
            exists(/databases/$(database)/documents/arenas/$(arenaId)) &&
            get(/databases/$(database)/documents/arenas/$(arenaId)).data.managerUserId == request.auth.uid
          )
        );
        allow create, update, delete: if false;
      }
    }
    match /arenaWithdrawals/{withdrawalId} {
      allow read: if request.auth != null && (
        isSuperAdmin() ||
        isAdmin() ||
        (
          resource != null &&
          exists(/databases/$(database)/documents/arenas/$(resource.data.arenaId)) &&
          get(/databases/$(database)/documents/arenas/$(resource.data.arenaId)).data.managerUserId == request.auth.uid
        )
      );
      allow create: if false;
      allow update: if request.auth != null && (isSuperAdmin() || isAdmin());
      allow delete: if false;
    }
    match /arenas/{arenaId}/products/{productId} {
      allow read: if canManageArenaProducts(arenaId);
      allow create: if canManageArenaProducts(arenaId) &&
        isValidArenaProductData(request.resource.data) &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.updatedAt is timestamp;
      allow update: if canManageArenaProducts(arenaId) && (
        isValidArenaProductStockUpdate() ||
        (
          isValidArenaProductData(request.resource.data) &&
          request.resource.data.updatedAt is timestamp &&
          request.resource.data.createdAt == resource.data.createdAt
        )
      );
      allow delete: if canManageArenaProducts(arenaId);
    }
    match /arenas/{arenaId}/sales/{saleId} {
      allow read, create: if canManageArenaProducts(arenaId);
      allow update, delete: if false;
    }
    match /arenas/{arenaId}/stockMovements/{movementId} {
      allow read: if canManageArenaProducts(arenaId);
      allow create: if isValidArenaStockMovementCreate(
        arenaId,
        request.resource.data.productId
      );
      allow update, delete: if false;
    }
    match /arenas/{arenaId}/metadata/{docId} {
      allow read: if canManageArenaProducts(arenaId);
      allow create, update: if docId == 'comandaCounter' &&
        canManageArenaProducts(arenaId) &&
        request.resource.data.keys().hasAll(['lastNumber', 'updatedAt']) &&
        request.resource.data.lastNumber is int &&
        request.resource.data.lastNumber > 0 &&
        request.resource.data.lastNumber <= 999999 &&
        request.resource.data.updatedAt is timestamp &&
        (
          resource == null ||
          request.resource.data.lastNumber == resource.data.lastNumber + 1
        );
      allow delete: if false;
    }
    match /arenaComandas/{comandaId} {
      allow read: if request.auth != null && (
        isSuperAdmin() ||
        (resource != null && isArenaManagerByArenaId(resource.data.arenaId))
      );
      allow create: if request.auth != null &&
        isValidArenaComandaCreate(request.resource.data);
      allow update: if request.auth != null && (
        isSuperAdmin() ||
        canManageArenaProducts(resource.data.arenaId)
      ) && isValidArenaComandaUpdate();
      allow delete: if false;
      match /items/{itemId} {
        allow read: if request.auth != null && (
          isSuperAdmin() ||
          canManageArenaProducts(
            get(/databases/$(database)/documents/arenaComandas/$(comandaId)).data.arenaId
          )
        );
        allow create: if request.auth != null &&
          isValidArenaComandaItemCreate(comandaId, request.resource.data);
        allow delete: if request.auth != null &&
          isValidArenaComandaItemDelete(comandaId);
        allow update: if false;
      }
      match /payments/{paymentId} {
        allow read: if request.auth != null && (
          isSuperAdmin() ||
          canManageArenaProducts(
            get(/databases/$(database)/documents/arenaComandas/$(comandaId)).data.arenaId
          )
        );
        allow create: if request.auth != null &&
          isValidArenaComandaPaymentCreate(comandaId, request.resource.data);
        allow update, delete: if false;
      }
    }
    match /arenaSlots/{slotId} {
      allow read: if true;
      allow create: if request.auth != null && (
        isSuperAdmin() ||
        (exists(/databases/$(database)/documents/arenas/$(request.resource.data.arenaId)) &&
         get(/databases/$(database)/documents/arenas/$(request.resource.data.arenaId)).data.managerUserId == request.auth.uid)
      );
      allow update: if request.auth != null && (
        isSuperAdmin() ||
        (exists(/databases/$(database)/documents/arenas/$(resource.data.arenaId)) &&
         get(/databases/$(database)/documents/arenas/$(resource.data.arenaId)).data.managerUserId == request.auth.uid)
      );
      allow delete: if request.auth != null && (
        isSuperAdmin() ||
        (exists(/databases/$(database)/documents/arenas/$(resource.data.arenaId)) &&
         get(/databases/$(database)/documents/arenas/$(resource.data.arenaId)).data.managerUserId == request.auth.uid)
      );
    }

    // Reservas criadas pelo app NexaGO (atleta): um documento por slot.
    match /bookings/{bookingId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.arenaId is string &&
        request.resource.data.slotId is string &&
        request.resource.data.status == 'pending' &&
        request.resource.data.paymentType == 'local';
      allow update, delete: if false;
    }
    match /arenaSlotLocks/{lockId} {
      allow read: if true;
      allow create: if request.auth != null && (
        isSuperAdmin() ||
        (exists(/databases/$(database)/documents/arenas/$(request.resource.data.arenaId)) &&
         get(/databases/$(database)/documents/arenas/$(request.resource.data.arenaId)).data.managerUserId == request.auth.uid)
      );
      allow update, delete: if request.auth != null && (
        isSuperAdmin() ||
        (exists(/databases/$(database)/documents/arenas/$(resource.data.arenaId)) &&
         get(/databases/$(database)/documents/arenas/$(resource.data.arenaId)).data.managerUserId == request.auth.uid)
      );
    }
    // Links curtos de convite (crescimento viral): leitura pública com dados mínimos da reserva
    match /arenaBookingInvites/{shareCode} {
      allow read: if true;
      allow create: if request.auth != null
        && shareCode.size() >= 6
        && shareCode.size() <= 12
        && request.resource.data.keys().hasAll([
          'bookingId', 'arenaId', 'arenaName', 'courtName', 'date', 'startTime', 'endTime', 'amountReais', 'courtCapacity'
        ])
        && request.resource.data.bookingId is string
        && request.resource.data.arenaId is string
        && request.resource.data.arenaName is string
        && request.resource.data.courtName is string
        && request.resource.data.date is string
        && request.resource.data.startTime is string
        && request.resource.data.endTime is string
        && request.resource.data.amountReais is number
        && (
          request.resource.data.courtCapacity == null ||
          (request.resource.data.courtCapacity is int && request.resource.data.courtCapacity >= 0)
        )
        && exists(/databases/$(database)/documents/arenaBookings/$(request.resource.data.bookingId))
        && get(/databases/$(database)/documents/arenaBookings/$(request.resource.data.bookingId)).data.athleteId == request.auth.uid
        && get(/databases/$(database)/documents/arenaBookings/$(request.resource.data.bookingId)).data.arenaId == request.resource.data.arenaId;
      allow update, delete: if false;
    }

    match /arenaBookings/{bookingId} {
      allow read: if request.auth != null && (
        resource.data.athleteId == request.auth.uid ||
        resource.data.bookingAthleteId == request.auth.uid ||
        (exists(/databases/$(database)/documents/arenas/$(resource.data.arenaId)) &&
         get(/databases/$(database)/documents/arenas/$(resource.data.arenaId)).data.managerUserId == request.auth.uid) ||
        isSuperAdmin()
      );
      allow create: if request.auth != null && (
        isSuperAdmin() ||
        (
          exists(/databases/$(database)/documents/arenas/$(request.resource.data.arenaId)) &&
          get(/databases/$(database)/documents/arenas/$(request.resource.data.arenaId)).data.managerUserId == request.auth.uid
        )
      );
      allow update: if request.auth != null && (
        resource.data.athleteId == request.auth.uid ||
        (exists(/databases/$(database)/documents/arenas/$(resource.data.arenaId)) &&
         get(/databases/$(database)/documents/arenas/$(resource.data.arenaId)).data.managerUserId == request.auth.uid) ||
        isSuperAdmin()
      );
      allow delete: if false;
    }

    // Bloqueio de atleta por arena (gestor -> arena_blocks/{arenaId}_{athleteId})
    match /arena_blocks/{blockId} {
      allow read: if request.auth != null && (
        isSuperAdmin() ||
        (
          resource != null &&
          resource.data.arenaId is string &&
          isArenaManagerByArenaId(resource.data.arenaId)
        )
      );

      allow create, update: if request.auth != null && (
        isSuperAdmin() ||
        (
          request.resource.data.arenaId is string &&
          request.resource.data.athleteId is string &&
          request.resource.data.reason is string &&
          request.resource.data.reason.size() > 0 &&
          request.resource.data.reason.size() <= 500 &&
          isArenaManagerByArenaId(request.resource.data.arenaId)
        )
      );

      allow delete: if request.auth != null && (
        isSuperAdmin() ||
        (
          resource != null &&
          resource.data.arenaId is string &&
          isArenaManagerByArenaId(resource.data.arenaId)
        )
      );
    }

    // Regras para a coleção de usuários
    match /users/{userId} {
      // Leitura pública de informações básicas de atletas (para tela pública)
      // Leitura completa: usuários podem ler seus próprios dados ou admins podem ler qualquer usuário
      allow read: if 
        (resource != null && userDocIsPublicAthlete(resource)) ||
        (request.auth != null && (
          request.auth.uid == userId ||
          isAdmin() ||
          (
            resource.data.partnerInviteStatus == 'pending' &&
            resource.data.invitedByUid == request.auth.uid
          )
        ));
      
      // Criar: próprio usuário, admin ou pré-cadastro de parceiro (inscrição)
      allow create: if request.auth != null && (
        (
          request.auth.uid == userId &&
          (!('role' in request.resource.data) || request.resource.data.role == 'athlete') &&
          (
            !('roles' in request.resource.data) ||
            (
              request.resource.data.roles is list &&
              !request.resource.data.roles.hasAny(['admin', 'arena', 'organizer'])
            )
          ) &&
          (!('superAdmin' in request.resource.data) || request.resource.data.superAdmin == false)
        ) ||
        isAdmin() ||
        isPartnerPreRegistrationCreate(userId)
      );
      
      // Atualizar: próprio usuário pode atualizar a si mesmo sem alterar role/superAdmin;
      // super admin ou convidador do parceiro pendente
      allow update: if request.auth != null && (
        (
          request.auth.uid == userId &&
          (
            !('email' in request.resource.data) ||
            request.resource.data.email == resource.data.email ||
            (
              request.auth.token.email is string &&
              request.resource.data.email == request.auth.token.email
            )
          ) &&
          (
            !('role' in request.resource.data) ||
            request.resource.data.role == resource.data.role
          ) &&
          (
            !('roles' in request.resource.data) ||
            request.resource.data.roles == resource.data.roles
          ) &&
          (
            !('superAdmin' in request.resource.data) ||
            request.resource.data.superAdmin == resource.data.superAdmin
          )
        ) ||
        isSuperAdmin() ||
        isPartnerPreRegistrationUpdateByInviter(userId)
      );
      
      // Deletar: apenas super admin pode deletar usuários (e apenas outros, não a si mesmo)
      allow delete: if request.auth != null && request.auth.uid != userId && isSuperAdmin();
    }

    // Regras para notificações do usuário
    match /users/{userId}/tokens/{tokenId} {
      allow read, create, update, delete: if request.auth != null && (
        request.auth.uid == userId ||
        isAdmin() ||
        isSuperAdmin()
      );
    }

    // Assinaturas Web Push (fallback iOS/Safari PWA)
    match /users/{userId}/webPushSubscriptions/{subscriptionId} {
      allow read, create, update, delete: if request.auth != null && (
        request.auth.uid == userId ||
        isAdmin() ||
        isSuperAdmin()
      );
    }

    match /users/{userId}/notifications/{notificationId} {
      // Usuários podem ler apenas suas próprias notificações
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Usuários podem atualizar apenas suas próprias notificações (marcar como lida)
      allow update: if request.auth != null && request.auth.uid == userId;
      
      // Apenas o sistema (via Cloud Functions) pode criar notificações
      // Usuários não podem criar suas próprias notificações
      allow create: if false;
    }

    match /users/{userId}/favorites/{arenaId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/followers/{followerId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.auth.uid == followerId &&
        request.auth.uid != userId;
      allow delete: if request.auth != null && request.auth.uid == followerId;
    }

    match /users/{userId}/following/{followingId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        request.auth.uid == followingId
      );
      allow create, delete: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/followingTeams/{teamId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.data.teamId == teamId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Índice de torneios em que o atleta atua como staff (espelho de tournaments/{id}/staff/{userId})
    match /users/{userId}/tournamentStaff/{tournamentId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update, delete: if request.auth != null && canManageTournament(tournamentId);
    }

    match /users/{userId}/slotVacancyAlerts/{alertId} {
      allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/slotVacancyNotifyLocks/{lockId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Gamificacao do atleta — somente Cloud Functions
    match /users/{userId}/gamification/{docId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    match /users/{userId}/gamification_badges/{badgeId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    match /users/{userId}/gamification_daily_missions/{dayKey} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    match /users/{userId}/gamification_events/{eventId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    match /arena_reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.arenaId is string &&
        request.resource.data.bookingId is string &&
        request.resource.data.rating is int &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5 &&
        (
          !('comment' in request.resource.data) ||
          request.resource.data.comment == null ||
          request.resource.data.comment is string
        ) &&
        (
          !('likesCount' in request.resource.data) ||
          request.resource.data.likesCount == 0
        ) &&
        (
          !('reported' in request.resource.data) ||
          request.resource.data.reported == false
        );
      allow update: if request.auth != null && (
        // atleta autor pode editar sua própria avaliação sem tocar em `reply`
        (
          resource.data.userId == request.auth.uid &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.arenaId == resource.data.arenaId &&
          request.resource.data.bookingId == resource.data.bookingId &&
          request.resource.data.reply == resource.data.reply &&
          request.resource.data.likesCount == resource.data.likesCount &&
          request.resource.data.reported == resource.data.reported
        ) ||
        // gestor da arena pode criar/editar apenas a resposta oficial
        (
          isArenaManagerByArenaId(resource.data.arenaId) &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.arenaId == resource.data.arenaId &&
          request.resource.data.bookingId == resource.data.bookingId &&
          request.resource.data.rating == resource.data.rating &&
          request.resource.data.comment == resource.data.comment &&
          request.resource.data.reply is map &&
          request.resource.data.reply.message is string &&
          request.resource.data.reply.message.size() >= 5 &&
          request.resource.data.reply.message.size() <= 300 &&
          (
            !('repliedBy' in request.resource.data.reply) ||
            request.resource.data.reply.repliedBy == request.auth.uid ||
            request.resource.data.reply.repliedBy == resource.data.arenaId
          )
        ) ||
        // qualquer usuário autenticado pode apenas sincronizar likesCount
        // junto com sua subcoleção likes/{uid} (transação like/unlike)
        (
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.arenaId == resource.data.arenaId &&
          request.resource.data.bookingId == resource.data.bookingId &&
          request.resource.data.rating == resource.data.rating &&
          request.resource.data.comment == resource.data.comment &&
          request.resource.data.reply == resource.data.reply &&
          request.resource.data.reported == resource.data.reported &&
          (
            (
              request.resource.data.likesCount == resource.data.likesCount + 1 &&
              !exists(/databases/$(database)/documents/arena_reviews/$(reviewId)/likes/$(request.auth.uid)) &&
              existsAfter(/databases/$(database)/documents/arena_reviews/$(reviewId)/likes/$(request.auth.uid))
            ) ||
            (
              request.resource.data.likesCount == resource.data.likesCount - 1 &&
              resource.data.likesCount > 0 &&
              exists(/databases/$(database)/documents/arena_reviews/$(reviewId)/likes/$(request.auth.uid)) &&
              !existsAfter(/databases/$(database)/documents/arena_reviews/$(reviewId)/likes/$(request.auth.uid))
            )
          )
        )
      );
      allow delete: if request.auth != null &&
        resource.data.userId == request.auth.uid;
    }
    match /arena_reviews/{reviewId}/likes/{userId} {
      allow read: if true;
      allow create, delete: if request.auth != null && request.auth.uid == userId;
      allow update: if false;
    }
    match /arena_reviews/{reviewId}/reports/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        isAdmin() ||
        isSuperAdmin()
      );
      allow create, update: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.data.reason is string &&
        request.resource.data.reason.size() >= 5 &&
        request.resource.data.reason.size() <= 280;
      allow delete: if false;
    }
    match /arena_reputation/{arenaId} {
      allow read: if true;
      allow write: if false;
    }

    // O perfil do atleta é armazenado diretamente em users/{userId}
    // As regras acima já cobrem isso - usuários podem ler/escrever seus próprios dados
    //
    // Perfil do atleta v1 no app Flutter: athletes/{athleteId}
    match /athletes/{athleteId} {
      // Leitura: próprio atleta ou admin
      allow read: if request.auth != null && (
        request.auth.uid == athleteId ||
        isAdmin() ||
        isSuperAdmin()
      );

      // Escrita: próprio atleta ou admin
      allow write: if request.auth != null && (
        request.auth.uid == athleteId ||
        isAdmin() ||
        isSuperAdmin()
      );
    }

    // Regras para perfil do administrador: /artifacts/{appId}/users/{userId}/profile/data
    match /artifacts/{appId}/users/{userId}/profile/{profileId} {
      // Usuários podem ler apenas seu próprio perfil
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Usuários podem criar/atualizar apenas seu próprio perfil
      allow create, update: if request.auth != null && request.auth.uid == userId;
      
      // Admins podem ler perfis de qualquer usuário
      allow read: if request.auth != null && isAdmin();
    }

    // Regras para torneios
    match /tournaments/{tournamentId} {
      // Leitura pública: qualquer pessoa (autenticada ou não) pode ler torneios
      // Isso permite que a tela pública funcione sem login
      allow read: if true;
      
      // Criar: admin da plataforma ou gestor de torneios
      allow create: if request.auth != null && (
        isAdmin() ||
        isSuperAdmin() ||
        organizerCanCreateTournament()
      );
      
      // Atualizar/deletar: gestor do torneio, admin da plataforma ou gestor de torneios
      allow update, delete: if request.auth != null && (
        isAdmin() ||
        isSuperAdmin() ||
        (isTournamentOrganizer() && organizerCanUpdateOwnTournament()) ||
        resource.data.managerId == request.auth.uid ||
        isTournamentStaff(tournamentId, ['manager'])
      );

      match /staff/{staffUserId} {
        allow read: if request.auth != null && (
          canManageTournament(tournamentId) ||
          request.auth.uid == staffUserId
        );
        allow create, update, delete: if request.auth != null && canManageTournament(tournamentId);
      }
    }

    // Regras para a coleção de equipes (equipes base - apenas dupla de atletas)
    // Caminho: /artifacts/{appId}/public/data/teams
    match /artifacts/{appId}/public/data/teams/{teamId} {
      allow read: if true;
      
      // Criar: apenas via Cloud Functions (convite aceito).
      allow create: if false;
      
      // Atualizar: jogadores da equipe (sem trocar player IDs) ou super admin
      allow update: if request.auth != null && (
        (
          (resource.data.player1Id == request.auth.uid || resource.data.player2Id == request.auth.uid) &&
          teamPlayerIdsUnchanged()
        ) ||
        isSuperAdmin()
      );
      
      // Deletar: apenas super admin pode deletar equipes base
      allow delete: if request.auth != null && isSuperAdmin();
    }

    // Regras para a coleção de inscrições de equipes em torneios
    // Caminho: /artifacts/{appId}/public/data/inscriptions
    // IMPORTANTE: Esta regra deve vir antes da regra padrão para ter prioridade
    // Inscrições: par único por categoria (mesmos integrantes) é enforced em
    // acceptTournamentPartnerInvite (Cloud Functions), não nas rules.
    match /artifacts/{appId}/public/data/inscriptions/{registrationId} {
      // Leitura: documento individual (chaves); list exige login (evita scrape em massa).
      allow get: if true;
      allow list: if request.auth != null;
      
      // Criar inscrição: apenas admin (fluxo atleta via Cloud Functions).
      allow create: if request.auth != null && isAdmin() &&
        inscriptionCreatePaymentSafe() &&
        inscriptionParticipantUidsMatchTeam(appId, request.resource.data.teamId);
      
      // Atualizar inscrição: jogador da dupla (sem campos sensíveis) ou admin
      allow update: if request.auth != null && (
        (
          (exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/teams/$(resource.data.teamId)) &&
           (get(/databases/$(database)/documents/artifacts/$(appId)/public/data/teams/$(resource.data.teamId)).data.player1Id == request.auth.uid ||
            get(/databases/$(database)/documents/artifacts/$(appId)/public/data/teams/$(resource.data.teamId)).data.player2Id == request.auth.uid)) &&
          inscriptionPaymentFieldsUnchanged() &&
          inscriptionEnrollmentFieldsUnchanged() &&
          inscriptionParticipantUidsImmutable() &&
          inscriptionCoreFieldsImmutable()
        ) ||
        isAdmin()
      );
      
      // Deletar inscrição: atleta/gestor só se não paga; admin sempre
      allow delete: if request.auth != null && (
        isAdmin() ||
        (
          resource.data.isPaid != true &&
          (
            (exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/teams/$(resource.data.teamId)) &&
             (get(/databases/$(database)/documents/artifacts/$(appId)/public/data/teams/$(resource.data.teamId)).data.player1Id == request.auth.uid ||
              get(/databases/$(database)/documents/artifacts/$(appId)/public/data/teams/$(resource.data.teamId)).data.player2Id == request.auth.uid)) ||
            canManageTournament(resource.data.tournamentId)
          )
        )
      );
    }

    // Regras para a coleção de partidas (matches)
    // Caminho: /artifacts/{appId}/public/data/matches
    match /artifacts/{appId}/public/data/matches/{matchId} {
      // Leitura pública: qualquer pessoa (autenticada ou não) pode ler partidas
      // Isso permite que a tela pública visualize chaves e resultados
      allow read: if true;
      
      // Criar partida: apenas admins podem criar
      allow create: if request.auth != null && isAdmin();
      
      // Atualizar partida: admin ou ACL por torneio (owner/staff manager/scorer).
      allow update: if request.auth != null && (
        isAdmin() ||
        isSuperAdmin() ||
        (
          canManageTournament(resource.data.tournamentId) &&
          request.resource.data.tournamentId == resource.data.tournamentId &&
          managerCanOnlyEditMatchFields()
        ) ||
        (
          canScoreTournament(resource.data.tournamentId) &&
          request.resource.data.tournamentId == resource.data.tournamentId &&
          scorerCanOnlyEditScoreFields()
        )
      );
      
      // Deletar partida: apenas admins podem deletar
      allow delete: if request.auth != null && isAdmin();

      // Timeline append-only de lançamento (replay / analytics).
      match /pointEvents/{eventId} {
        allow read: if true;
        allow create: if canWriteMatchPointEvents(appId, matchId) && isValidPointEventCreate(appId, matchId);
        allow update, delete: if false;
      }

      // Audit log operacional (I4) — append-only.
      // Leitura restrita à equipe do torneio: metadados operacionais (byUid/byRole)
      // não devem ser públicos. Nenhum cliente consome este log (somente escrita).
      match /auditLog/{eventId} {
        allow read: if request.auth != null && matchDoc(appId, matchId).data != null && (
          isAdmin() ||
          isSuperAdmin() ||
          canManageTournament(matchDoc(appId, matchId).data.tournamentId) ||
          canScoreTournament(matchDoc(appId, matchId).data.tournamentId)
        );
        allow create: if request.auth != null && matchDoc(appId, matchId).data != null && (
          isAdmin() ||
          isSuperAdmin() ||
          canManageTournament(matchDoc(appId, matchId).data.tournamentId) ||
          canScoreTournament(matchDoc(appId, matchId).data.tournamentId)
        );
        allow update, delete: if false;
      }
    }
    
    // Regras para mensagens de contato (criação apenas via Cloud Function após validar captcha)
    match /contactMessages/{messageId} {
      // Criação apenas pelo backend (submitContactMessageSecure); cliente não pode criar direto
      allow create: if false;
      
      // Apenas admins podem ler mensagens de contato
      allow read: if request.auth != null && isAdmin();
      
      // Apenas admins podem atualizar (marcar como lida, etc.)
      allow update: if request.auth != null && isAdmin();
      
      // Apenas admins podem deletar
      allow delete: if request.auth != null && isAdmin();
    }

    // Regras para perfis PRO de atletas
    match /athlete_profiles/{athleteId} {
      // Leitura pública quando o perfil estiver publicado.
      // O próprio atleta e admins também podem ler sempre.
      allow read: if
        (resource != null && resource.data.publicProfileEnabled == true) ||
        (request.auth != null && (
          request.auth.uid == athleteId ||
          isAdmin()
        ));
      
      // Escrita: apenas próprio atleta ou admin
      allow write: if request.auth != null && (
        request.auth.uid == athleteId ||
        isAdmin()
      );
    }

    // Regras para badges (somente leitura para todos autenticados)
    match /badges/{badgeId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }

    // Resultados por categoria (posição final e pontos) - ranking
    // Caminho: /artifacts/{appId}/public/data/tournamentCategoryResults
    match /artifacts/{appId}/public/data/tournamentCategoryResults/{resultId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && isAdmin();
    }

    // Ranking de equipes (agregado) - leitura pública para página de ranking
    // Caminho: /artifacts/{appId}/public/data/teamRankings
    // Para aplicar: firebase deploy --only firestore:rules
    match /artifacts/{appId}/public/data/teamRankings/{teamId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && isAdmin();
    }

    // Ranking de atletas (agregado) - leitura pública para página de ranking
    // Caminho: /artifacts/{appId}/public/data/athleteRankings
    match /artifacts/{appId}/public/data/athleteRankings/{athleteId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && isAdmin();
    }

    // Ranking agregado por liga/categoria (equipes) - leitura pública
    match /artifacts/{appId}/public/data/leagueTeamRankings/{entryId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && isAdmin();
    }

    // Ranking agregado por liga/categoria (atletas) - leitura pública
    match /artifacts/{appId}/public/data/leagueAthleteRankings/{entryId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && isAdmin();
    }

    // Ligas (metadados e gestão de temporada)
    match /leagues/{leagueId} {
      allow read: if true;
      allow create: if request.auth != null && (
        isAdmin() ||
        (
          request.resource.data.managerId == request.auth.uid &&
          request.resource.data.name is string &&
          request.resource.data.name.size() > 0 &&
          isValidLeagueListingStatus(request.resource.data.listingStatus) &&
          request.resource.data.listingStatus in ['draft', 'open']
        )
      );
      allow update: if request.auth != null && (
        isAdmin() ||
        organizerCanUpdateOwnLeague()
      );
      allow delete: if request.auth != null && (
        isAdmin() ||
        resource.data.managerId == request.auth.uid
      );
    }

    // Avaliações de categoria (feedback dos atletas)
    // Caminho: /artifacts/{appId}/public/data/category_feedbacks
    match /artifacts/{appId}/public/data/category_feedbacks/{feedbackId} {
      // Leitura: documento público (isPrivate == false) qualquer um; documento privado só o autor ou o gestor do torneio
      allow read: if resource == null || (
        resource.data.isPrivate == false ||
        (request.auth != null && request.auth.uid == resource.data.userId) ||
        (request.auth != null && isAdmin() && exists(/databases/$(database)/documents/tournaments/$(resource.data.tournamentId)) && get(/databases/$(database)/documents/tournaments/$(resource.data.tournamentId)).data.managerId == request.auth.uid)
      );
      // Criar: apenas usuário autenticado como autor (userId)
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      // Atualizar: apenas o autor do feedback
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // Depoimentos (marketing) - leitura pública; escrita apenas super admin
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && isSuperAdmin();
    }

    // Patrocinadores da plataforma - leitura pública; escrita apenas super admin
    match /platformSponsors/{sponsorId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && isSuperAdmin();
    }

    // Funnel de instalação PWA + push por usuário
    match /pwaInstallations/{eventId} {
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        isAdmin() ||
        isSuperAdmin()
      );
      allow update, delete: if false;
    }
    
    // NexaGO — visão operacional (documentos agregados para o backoffice; manter status no backend)
    match /torneios/{torneioId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && (
        isAdmin() ||
        isSuperAdmin() ||
        organizerCanCreateOperationalTorneio()
      );
      allow update: if request.auth != null && (
        isAdmin() ||
        isSuperAdmin() ||
        organizerCanUpdateOwnOperationalTorneio()
      );
      allow delete: if request.auth != null && (
        isAdmin() ||
        isSuperAdmin() ||
        organizerCanDeleteOwnOperationalTorneio()
      );
    }

    // Convites de parceiro para inscrição em torneio (escrita via Cloud Functions)
    match /tournamentRegistrationInvites/{inviteId} {
      allow read: if request.auth != null && (
        resource.data.inviterUid == request.auth.uid ||
        resource.data.inviteeUid == request.auth.uid
      );
      allow list: if request.auth != null;
      allow create, update, delete: if false;
    }

    // Lista de espera do site público (captura de e-mail pré-lançamento).
    // Criação pública e validada (sem auth); leitura/edição/remoção bloqueadas.
    match /waitlist/{docId} {
      allow read, update, delete: if false;
      allow create: if
        request.resource.data.keys().hasOnly(['email', 'source', 'createdAt']) &&
        request.resource.data.email is string &&
        request.resource.data.email.size() >= 5 &&
        request.resource.data.email.size() <= 320 &&
        request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+[.][^@\\s]+$') &&
        request.resource.data.source is string &&
        request.resource.data.source.size() <= 64 &&
        request.resource.data.createdAt is timestamp;
    }

    // Leads B2B do site (organizadores e arenas). Criação pública e validada
    // (sem auth, via Route Handler); leitura/edição/remoção bloqueadas.
    match /leads/{docId} {
      allow read, update, delete: if false;
      allow create: if
        request.resource.data.keys().hasOnly(
          ['name', 'email', 'phone', 'org', 'message', 'persona', 'source', 'createdAt']
        ) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() >= 2 &&
        request.resource.data.name.size() <= 120 &&
        request.resource.data.email is string &&
        request.resource.data.email.size() >= 5 &&
        request.resource.data.email.size() <= 320 &&
        request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+[.][^@\\s]+$') &&
        request.resource.data.phone is string &&
        request.resource.data.phone.size() <= 40 &&
        request.resource.data.org is string &&
        request.resource.data.org.size() <= 160 &&
        request.resource.data.message is string &&
        request.resource.data.message.size() <= 1000 &&
        request.resource.data.persona in ['organizador', 'arena', 'geral'] &&
        request.resource.data.source is string &&
        request.resource.data.source.size() <= 64 &&
        request.resource.data.createdAt is timestamp;
    }

    // Regras padrão para outras coleções (ajuste conforme necessário)
    // IMPORTANTE: Esta regra NÃO deve interferir com as regras específicas acima
    // As regras específicas têm prioridade sobre esta regra padrão
    // Esta regra só se aplica a caminhos que não correspondem às regras acima
    match /{document=**} {
      // Mantém leitura autenticada, mas bloqueia escrita não mapeada explicitamente.
      // Isso evita novos caminhos com permissão de escrita aberta por engano.
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
